# Copia este archivo a `.env` y llena los valores. `.env` NO se versiona.
#
# Astro solo expone al navegador las variables con prefijo PUBLIC_. Todas las de
# aquí acaban en el HTML publicado: no pongas nada secreto en este archivo.

# ---------------------------------------------------------------------------
# Formulario de contacto — OBLIGATORIO ANTES DE PUBLICAR
# ---------------------------------------------------------------------------
# Endpoint que recibe el formulario. Sirve cualquier proveedor que acepte un
# POST de FormData y responda JSON: Formspree, Basin, Getform, Netlify Forms o
# una función serverless propia.
#
# Sin esta variable el formulario NO se envía: se muestra un aviso y el botón
# queda deshabilitado. Es deliberado — un formulario que parece funcionar y tira
# el mensaje es peor que no tener formulario.
#
# Web3Forms (recomendado: 250 mensajes al mes, sin cuenta):
#   PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
#   PUBLIC_FORM_ACCESS_KEY=<la clave que Web3Forms manda por correo>
#
# Formspree (50 al mes, con cuenta). Ahi el identificador va en la URL y
# PUBLIC_FORM_ACCESS_KEY se deja vacia:
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
PUBLIC_FORM_ENDPOINT=

# Solo la piden los proveedores que identifican el formulario por el cuerpo del
# envio y no por la URL. Vacia si usas Formspree.
PUBLIC_FORM_ACCESS_KEY=

# Correo de contacto que se publica en el pie del formulario y en el aviso de
# privacidad (para ejercer derechos ARCO). Si se deja vacío no se imprime
# ningún correo: preferible a inventar uno que rebote.
PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Analítica — opcional
# ---------------------------------------------------------------------------
# Cada script se inyecta SOLO si su variable tiene valor. Vacías, el sitio no
# carga ningún tercero y no coloca cookies.
#
# Si activas alguna, actualiza el apartado "Cookies y analítica" del aviso de
# privacidad: hoy dice que no hay ningún servicio activo.
PUBLIC_GA_ID=
PUBLIC_CLARITY_ID=
