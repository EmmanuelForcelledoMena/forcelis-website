# Copia este archivo a `.env` y llena los valores. `.env` NO se versiona.
#
# Astro solo expone al navegador las variables con prefijo PUBLIC_. Todas las de
# aquí acaban en el HTML publicado: no pongas nada secreto en este archivo.
#
# LA ANALÍTICA NO ESTÁ AQUÍ. Los identificadores de GA4, Meta Pixel y Google Ads
# viven en `src/config/negocio.ts`, junto a los precios y las ligas de agenda y
# registro, porque son el mismo interruptor comercial y conviene que haya un
# solo archivo que tocar. Microsoft Clarity se retiró del proyecto.

# ---------------------------------------------------------------------------
# Formulario de contacto — OBLIGATORIO ANTES DE PUBLICAR
# ---------------------------------------------------------------------------
# Endpoint que recibe el formulario. Sirve cualquier proveedor que acepte un
# POST de FormData y responda JSON: Web3Forms, Formspree, Basin, Getform o una
# función serverless propia.
#
# Sin esta variable el formulario NO se envía: se muestra un aviso y el botón
# queda deshabilitado. Es deliberado — un formulario que parece funcionar y tira
# el mensaje es peor que no tener formulario.
#
# Web3Forms (el que usa el sitio hoy):
#   PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
#   PUBLIC_FORM_ACCESS_KEY=<la clave que Web3Forms manda por correo>
#
# Formspree. Ahí el identificador va en la URL y PUBLIC_FORM_ACCESS_KEY se deja
# vacía:
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
PUBLIC_FORM_ENDPOINT=

# Solo la piden los proveedores que identifican el formulario por el cuerpo del
# envío y no por la URL. Vacía si usas Formspree.
PUBLIC_FORM_ACCESS_KEY=

# Correo de contacto que se publicaría en la página de contacto. Si se deja
# vacío no se imprime ninguno: preferible a publicar un buzón personal. Está
# deliberadamente SIN inyectar en el workflow de despliegue; el motivo está
# escrito ahí.
PUBLIC_CONTACT_EMAIL=
