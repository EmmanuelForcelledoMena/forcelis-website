---
/**
 * Raiz del sitio.
 *
 * Desde el giro a consultoria solo se sirve el espanol, asi que esto es un
 * reenvio sin decision: no hay preferencia de idioma que consultar ni segunda
 * version a la que mandar a nadie. Se conservan las tres capas —meta refresh,
 * script y enlace visible— porque cada una cubre el fallo de la anterior.
 */
const destino = '/es/';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forcelis</title>
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destino}`} />
    <link rel="canonical" href="https://forcelis-group.com/es/" />
  </head>
  <body>
    <p><a href={destino}>Ir a Forcelis</a></p>
    <script is:inline define:vars={{ destino }}>window.location.replace(destino);</script>
  </body>
</html>
