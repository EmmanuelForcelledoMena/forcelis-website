---
/**
 * Página 404.
 *
 * GitHub Pages sirve `/404.html` para cualquier ruta que no existe, y esa
 * respuesta es única para todo el sitio: no sabe si quien llegó venía de `/en/`
 * o de `/es/`. Por eso es la única página bilingüe del proyecto — enseña los dos
 * idiomas a la vez en lugar de adivinar.
 */
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Forcelis Group</title>
    <meta
      name="description"
      content="The page you were looking for does not exist. — La página que buscabas no existe."
    />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen bg-ground text-body">
    <div class="container-page flex min-h-screen flex-col justify-center py-20">
      <a href="/en/" aria-label="Forcelis Group">
        <Wordmark />
      </a>

      <p class="tnum mt-16 text-sm font-semibold tracking-[0.16em] text-brand-text">404</p>

      <div class="mt-6 grid gap-10 sm:grid-cols-2 sm:gap-16">
        <div lang="en">
          <h1 class="text-2xl font-semibold tracking-[-0.02em] text-ink">Page not found.</h1>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
            The page you were looking for does not exist, or it has moved.
          </p>
          <a
            href="/en/"
            class="mt-6 inline-flex items-center gap-2 bg-ink px-5 py-3 text-sm font-medium text-on-ink transition-colors hover:bg-ink-soft"
          >
            Back to the homepage
          </a>
        </div>

        <div lang="es">
          <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink">Página no encontrada.</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
            La página que buscabas no existe o cambió de dirección.
          </p>
          <a
            href="/es/"
            class="mt-6 inline-flex items-center gap-2 border border-line-strong px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-panel-alt"
          >
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
