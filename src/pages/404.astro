---
/**
 * Página 404.
 *
 * GitHub Pages sirve `/404.html` para cualquier ruta que no existe, y esa
 * respuesta es única para todo el sitio: no sabe si quien llegó venía de `/es/`
 * o de `/en/`. Por eso enseña los dos idiomas a la vez, cada bloque con su
 * `lang`, en lugar de adivinar. El español va primero: es la audiencia
 * principal.
 */
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página no encontrada — Forcelis</title>
    <meta name="description" content="La página que buscabas no existe. — The page you were looking for does not exist." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f6f4f3" />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=4" type="image/png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico?v=4" />
    <link rel="preload" href="/fonts/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen bg-ground text-body">
    <div class="container-page flex min-h-screen flex-col justify-center py-20">
      <a href="/es/" aria-label="Forcelis — Inicio" class="self-start">
        <Wordmark height={44} />
      </a>

      <p class="tnum mt-16 text-sm font-semibold tracking-[0.16em] text-brand-text">404</p>

      <div class="mt-6 grid gap-10 sm:grid-cols-2 sm:gap-16">
        <div>
          <h1 class="text-2xl font-medium tracking-[-0.01em] text-ink">Página no encontrada.</h1>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
            La página que buscabas no existe o cambió de dirección.
          </p>
          <a
            href="/es/"
            class="mt-6 inline-flex items-center gap-2 rounded-control bg-brand px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-vino"
          >
            Volver al inicio
          </a>
        </div>

        <div lang="en">
          <h2 class="text-2xl font-medium tracking-[-0.01em] text-ink">Page not found.</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
            The page you were looking for does not exist, or it has moved.
          </p>
          <a
            href="/en/"
            class="mt-6 inline-flex items-center gap-2 rounded-control border border-ink px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-ink hover:text-on-ink"
          >
            Back to the homepage
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
