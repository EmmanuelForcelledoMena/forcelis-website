---
/**
 * Envoltura de sección. Existe para que el ritmo vertical del sitio se decida
 * en un archivo y no en cuarenta clases repetidas: cambiar el aire entre
 * secciones es cambiar `py` aquí.
 */
interface Props {
  tone?: 'ground' | 'panel' | 'ink';
  id?: string;
  size?: 'default' | 'compact';
  class?: string;
}

const { tone = 'ground', id, size = 'default', class: className = '' } = Astro.props;

const tones = {
  ground: 'bg-ground text-body',
  panel: 'bg-panel-alt text-body',
  ink: 'on-ink bg-ink text-on-ink',
};

const sizes = {
  default: 'py-20 lg:py-section',
  compact: 'py-16 lg:py-24',
};

// Solo las secciones con `id` son destino de un ancla, y son las únicas que
// necesitan reservar el alto de la barra pegajosa. Sin esto el navegador alinea
// el borde de la sección con el borde de la ventana, la barra se come 73 de los
// 96 px de aire superior, y el título aterriza pegado a ella.
const anchorOffset = id ? 'scroll-mt-[6.5rem]' : '';
---

<section id={id} class={`${tones[tone]} ${sizes[size]} ${anchorOffset} ${className}`}>
  <div class="container-page">
    <slot />
  </div>
</section>
