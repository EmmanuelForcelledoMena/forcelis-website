---
/**
 * Botón/enlace del sistema.
 *
 * El acento cambia con la superficie, y la razón es de contraste, no de gusto:
 *
 * - Sobre CLARO el botón principal es rojo de marca con texto blanco (5.9:1,
 *   AA). Es lo que muestran los mockups del manual.
 * - Sobre TINTA el botón principal es el rojo LEVANTADO (`--color-brand-on-ink`,
 *   #d63b3b) con texto blanco: 3.8:1 de borde contra la tinta (WCAG 1.4.11
 *   pide 3:1) y 4.6:1 el texto (AA). El rojo del manual tal cual da 2.94:1 de
 *   borde y no pasa. Es lo que muestran los heros oscuros de los mockups.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'onInk' | 'onInkGhost';
  size?: 'md' | 'lg';
  class?: string;
  /** Cualquier otro atributo —`data-cta`, `rel`, `target`— pasa al enlace. */
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;

// `group` para que la flecha reaccione al pasar el ratón por el botón entero y
// no solo por encima de ella. Es el mismo gesto que ya hacen las tarjetas de
// solución; tenerlo en un sitio y no en el otro se nota.
//
// Por debajo de `sm` el texto PUEDE partirse en dos líneas. Con
// `whitespace-nowrap` fijo, un botón largo dentro de una retícula de una
// columna imponía su ancho a la columna entera, y a 320 px el hero de Asesores
// cortaba su propio texto. A partir de `sm` hay ancho de sobra y el botón
// vuelve a ser de una sola línea.
const base =
  'group inline-flex max-w-full items-center justify-center gap-2 text-center font-medium ' +
  'transition-colors duration-200 rounded-none sm:whitespace-nowrap';

// `lg` es más compacto por debajo de `sm`: con 28 px de margen a cada lado,
// «Solicitar un Diagnóstico Empresarial» ya no cabía en una línea a 360 px.
const sizes = {
  md: 'text-sm px-5 py-3',
  lg: 'text-sm px-5 py-4 sm:text-[0.9375rem] sm:px-7',
};

const variants = {
  primary: 'bg-brand text-white hover:bg-brand-text',
  secondary: 'border border-line-strong text-ink hover:bg-panel-alt hover:border-ink',
  onInk: 'bg-brand-on-ink text-white hover:bg-[#e04a4a]',
  onInkGhost: 'border border-on-ink-muted/50 text-on-ink hover:border-on-ink-muted hover:bg-white/5',
};
---

<a href={href} class={`${base} ${sizes[size]} ${variants[variant]} ${className}`} {...rest}>
  <slot />
  <svg
    width="14"
    height="14"
    viewBox="0 0 14 14"
    fill="none"
    aria-hidden="true"
    class="shrink-0 -mr-0.5 transition-transform duration-200 group-hover:translate-x-1"
  >
    <path
      d="M2.5 7h9M8 3.5 11.5 7 8 10.5"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="square"
    ></path>
  </svg>
</a>
