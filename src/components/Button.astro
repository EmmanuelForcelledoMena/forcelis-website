---
/**
 * Botón/enlace del sistema.
 *
 * Lo que pide la marca: principal en rojo con texto blanco (6.3:1); secundario
 * con contorno negro sobre claro. Esquinas suaves (`rounded-control`), las
 * mismas en todo el sitio.
 *
 * Sobre superficies oscuras el principal sigue siendo rojo con texto blanco —
 * es el botón de la hoja de marca— y el secundario es un contorno arena.
 */
import { negocio } from '../config/negocio';
import { esExterno } from '../config/enlaces';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'onInk' | 'onInkGhost';
  size?: 'md' | 'lg';
  class?: string;
  /** Cualquier otro atributo —`data-cta`, `rel`, `target`— pasa al enlace. */
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;

// La liga de agenda sale del sitio: se abre aparte, para no perder la página,
// y lleva `data-cta="agenda"` para medir el clic (solo con consentimiento).
// Se decide aquí para que ningún botón de agenda se quede sin ello.
const externo = esExterno(href) ? { target: '_blank', rel: 'noopener' } : {};
const medicion = negocio.url_agenda && href === negocio.url_agenda ? { 'data-cta': 'agenda' } : {};

// `group` para que la flecha reaccione al pasar el ratón por el botón entero y
// no solo por encima de ella. Es el mismo gesto que ya hacen las tarjetas de
// solución; tenerlo en un sitio y no en el otro se nota.
//
// Por debajo de `sm` el texto PUEDE partirse en dos líneas. Con
// `whitespace-nowrap` fijo, un botón largo dentro de una retícula de una
// columna imponía su ancho a la columna entera, y a 320 px el hero de Asesores
// cortaba su propio texto. A partir de `sm` hay ancho de sobra y el botón
// vuelve a ser de una sola línea.
const base =
  'group inline-flex max-w-full items-center justify-center gap-2 text-center font-medium ' +
  'transition-colors duration-200 rounded-control sm:whitespace-nowrap';

// `lg` es más compacto por debajo de `sm`: con 28 px de margen a cada lado,
// «Solicitar un Diagnóstico Empresarial» ya no cabía en una línea a 360 px.
const sizes = {
  md: 'text-sm px-5 py-3',
  lg: 'text-sm px-5 py-4 sm:text-[0.9375rem] sm:px-7',
};

const variants = {
  primary: 'bg-brand text-white hover:bg-vino',
  secondary: 'border border-ink text-ink hover:bg-ink hover:text-on-ink',
  onInk: 'bg-brand text-white hover:bg-[#bd3130]',
  onInkGhost: 'border border-on-ink-muted/70 text-on-ink hover:border-on-ink hover:bg-white/5',
};
---

<a href={href} class={`${base} ${sizes[size]} ${variants[variant]} ${className}`} {...externo} {...medicion} {...rest}>
  <slot />
  <svg
    width="14"
    height="14"
    viewBox="0 0 14 14"
    fill="none"
    aria-hidden="true"
    class="shrink-0 -mr-0.5 transition-transform duration-200 group-hover:translate-x-1"
  >
    <path
      d="M2.5 7h9M8 3.5 11.5 7 8 10.5"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="square"
    ></path>
  </svg>
</a>
