---
/**
 * Selector de idioma.
 *
 * NO traduce la página actual: el español y el inglés son líneas de negocio
 * distintas, no la misma página en dos idiomas. ES lleva siempre a `/es/` y
 * EN a `/en/`. Junto al selector va una nota corta, en el idioma de DESTINO
 * y marcada con su `lang`, que dice a quién le habla la otra versión: así
 * nadie espera encontrar del otro lado la traducción de lo que estaba leyendo.
 *
 * Sin banderas: una bandera es un país, no un idioma.
 */
import { LANG_META, otherLangs, path, type Lang } from '../i18n/routes';
import { common } from '../i18n';

interface Props {
  lang: Lang;
  tone?: 'ink' | 'light';
  /**
   * Dónde está. La barra y el pie tienen cada uno su selector, y dos `nav` con
   * la misma etiqueta no se distinguen en un lector de pantalla.
   */
  ubicacion?: 'cabecera' | 'pie' | 'menu';
  /** Clases para la nota: permite esconderla en pantallas estrechas. */
  noteClass?: string;
  class?: string;
}

const {
  lang,
  tone = 'ink',
  ubicacion = 'cabecera',
  noteClass = '',
  class: className = '',
} = Astro.props;
const c = common(lang);
const otro = otherLangs(lang)[0];

const activeColor = tone === 'light' ? 'text-on-ink' : 'text-ink';
const idleColor =
  tone === 'light' ? 'text-on-ink-muted hover:text-on-ink' : 'text-muted hover:text-ink';
const dividerColor = tone === 'light' ? 'text-line-ink' : 'text-line-strong';
const noteColor = tone === 'light' ? 'text-on-ink-muted' : 'text-muted';
const etiqueta = ubicacion === 'pie' ? c.lang.footerLabel : c.lang.label;
---

<nav
  aria-label={ubicacion === 'menu' ? `${c.lang.label} (menú)` : etiqueta}
  class={`flex items-center gap-3 ${className}`}
>
  <span class="flex items-center gap-2 text-xs">
    <span class={`font-semibold tracking-[0.08em] ${activeColor}`} aria-current="true">
      {LANG_META[lang].short}
      <span class="sr-only">— {c.lang.current}</span>
    </span>
    <span aria-hidden="true" class={dividerColor}>|</span>
    <a
      href={path('home', otro)}
      lang={LANG_META[otro].hreflang}
      hreflang={LANG_META[otro].hreflang}
      data-lang-choice={otro}
      class={`-m-1 inline-flex min-h-6 min-w-6 items-center justify-center p-1 font-medium tracking-[0.08em] transition-colors ${idleColor}`}
    >
      {LANG_META[otro].short}
      <span class="sr-only">— {c.lang.note}</span>
    </a>
  </span>
  <span lang={LANG_META[otro].hreflang} aria-hidden="true" class={`text-[0.6875rem] leading-tight ${noteColor} ${noteClass}`}>
    {c.lang.note}
  </span>
</nav>
