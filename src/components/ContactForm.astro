---
/**
 * Formulario de contacto.
 *
 * El sitio es estático, así que no hay servidor propio que reciba el envío: el
 * destino es un endpoint configurable (`PUBLIC_FORM_ENDPOINT`), compatible con
 * Formspree y equivalentes. No hay ninguna clave falsa en el código.
 *
 * Dos decisiones que importan:
 *
 * 1. **Sin endpoint configurado, el formulario lo dice.** La alternativa —un
 *    botón que parece funcionar y descarta el mensaje— es peor que no tener
 *    formulario: el visitante cree que escribió y nadie lo recibe.
 * 2. **Funciona sin JavaScript.** El `action` y el `method` son reales; el
 *    script solo intercepta para dar respuesta sin recargar. Si el script no
 *    corre, el envío sigue llegando.
 */
import type { Lang } from '../i18n/routes';
import { path } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = t(lang, 'contact').form;

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const configured = endpoint.length > 0;

const inputClass =
  'w-full border border-line-strong bg-panel px-4 py-3 text-[0.9375rem] text-ink ' +
  'placeholder:text-muted focus:border-ink focus:outline-none transition-colors';
const labelClass = 'block text-sm font-medium text-ink';
const hintClass = 'mt-1.5 text-xs text-muted';
---

<form
  id="contact-form"
  action={configured ? endpoint : undefined}
  method="post"
  data-configured={configured ? 'true' : 'false'}
  class="space-y-10"
  novalidate
>
  {
    !configured && (
      <div class="border-l-2 border-[var(--color-data-amber)] bg-panel-alt px-5 py-4">
        <p class="text-sm font-semibold text-ink">{f.unconfiguredTitle}</p>
        <p class="mt-1.5 text-sm text-muted">{f.unconfiguredBody}</p>
      </div>
    )
  }

  <fieldset class="space-y-6">
    <legend class="sr-only">{f.legend}</legend>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="company">{f.company}</label>
        <input class={`mt-2 ${inputClass}`} type="text" id="company" name="company" required autocomplete="organization" />
      </div>
      <div>
        <label class={labelClass} for="name">{f.name}</label>
        <input class={`mt-2 ${inputClass}`} type="text" id="name" name="name" required autocomplete="name" />
      </div>
      <div>
        <label class={labelClass} for="email">{f.email}</label>
        <input class={`mt-2 ${inputClass}`} type="email" id="email" name="email" required autocomplete="email" />
      </div>
      <div>
        <label class={labelClass} for="phone">
          {f.phone} <span class="font-normal text-muted">— {f.phoneOptional}</span>
        </label>
        <input class={`mt-2 ${inputClass}`} type="tel" id="phone" name="phone" autocomplete="tel" />
      </div>
      <div>
        <label class={labelClass} for="industry">{f.industry}</label>
        <select class={`mt-2 ${inputClass}`} id="industry" name="industry" required>
          <option value="">{f.industryPlaceholder}</option>
          {f.industries.map((industry) => <option value={industry}>{industry}</option>)}
        </select>
      </div>
      <div>
        <label class={labelClass} for="size">{f.size}</label>
        <select class={`mt-2 ${inputClass}`} id="size" name="size" required>
          <option value="">{f.sizePlaceholder}</option>
          {f.sizes.map((size) => <option value={size}>{size}</option>)}
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend class={labelClass}>{f.help}</legend>
    <p class={hintClass}>{f.helpHint}</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        f.helpOptions.map((option, i) => (
          <label class="flex cursor-pointer items-center gap-3 border border-line bg-panel px-4 py-3 text-[0.9375rem] text-ink transition-colors hover:border-line-strong">
            <input
              type="checkbox"
              name="interests"
              value={option}
              id={`interest-${i}`}
              class="h-4 w-4 shrink-0 accent-[var(--color-brand)]"
            />
            {option}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div>
    <label class={labelClass} for="message">{f.message}</label>
    <p class={hintClass} id="message-hint">{f.messageHint}</p>
    <textarea
      class={`mt-3 ${inputClass} min-h-40 resize-y`}
      id="message"
      name="message"
      rows="6"
      required
      aria-describedby="message-hint"></textarea>
  </div>

  <div class="border-t border-line pt-8">
    <label class="flex cursor-pointer items-start gap-3 text-sm text-muted">
      <input
        type="checkbox"
        id="consent"
        name="consent"
        required
        class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-brand)]"
      />
      <span>
        {f.consent}
        <a
          href={path('privacy', lang)}
          class="ml-1 font-medium text-brand-text underline underline-offset-2"
        >
          {f.consentLink}
        </a>
      </span>
    </label>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <button
        type="submit"
        id="contact-submit"
        disabled={!configured}
        data-label={f.submit}
        data-sending={f.submitting}
        class="inline-flex items-center gap-2 bg-ink px-7 py-4 text-[0.9375rem] font-medium text-on-ink transition-colors hover:bg-ink-soft disabled:cursor-not-allowed disabled:opacity-40"
      >
        {f.submit}
      </button>
    </div>

    <!-- Región viva: el resultado del envío tiene que anunciarse, no solo
         aparecer. Sin esto, quien usa lector de pantalla no sabe si el mensaje
         salió. -->
    <div id="form-status" role="status" aria-live="polite" class="mt-6 empty:mt-0"></div>
  </div>

  <!-- Trampa para robots: un campo que una persona no puede ver ni tabular. Si
       llega lleno, el envío se descarta en el navegador sin gastar el
       formulario del proveedor. -->
  <div class="hidden" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
</form>

<script
  is:inline
  define:vars={{
    successTitle: f.successTitle,
    successBody: f.successBody,
    errorTitle: f.errorTitle,
    errorBody: f.errorBody,
    invalidEmail: f.validationInvalidEmail,
    consentMissing: f.validationConsent,
  }}
>
  (() => {
    const form = document.getElementById('contact-form');
    if (!form || form.dataset.configured !== 'true') return;

    const button = document.getElementById('contact-submit');
    const status = document.getElementById('form-status');

    const render = (tone, title, body) => {
      const border = tone === 'ok' ? 'var(--color-data-green)' : 'var(--color-brand)';
      status.innerHTML =
        '<div style="border-left:2px solid ' +
        border +
        ';padding:1rem 1.25rem;background:var(--color-panel-alt)">' +
        '<p style="font-weight:600;color:var(--color-ink)"></p>' +
        '<p style="margin-top:.375rem;color:var(--color-muted);font-size:.875rem"></p></div>';
      const [titleNode, bodyNode] = status.querySelectorAll('p');
      titleNode.textContent = title;
      bodyNode.textContent = body;
    };

    form.addEventListener('submit', async (event) => {
      if (form.querySelector('[name="_gotcha"]').value) {
        event.preventDefault();
        return;
      }

      const email = form.querySelector('#email');
      const consent = form.querySelector('#consent');

      if (!form.checkValidity()) {
        event.preventDefault();
        if (!consent.checked) render('error', consentMissing, '');
        else if (!email.checkValidity()) render('error', invalidEmail, '');
        form.reportValidity();
        return;
      }

      event.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.sending;
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        render('ok', successTitle, successBody);
      } catch {
        render('error', errorTitle, errorBody);
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.label;
      }
    });
  })();
</script>
