---
/**
 * Barra de navegación.
 *
 * El botón apunta al cliente principal, que son los asesores. Contacto queda
 * como enlace de texto a su lado: el sitio pide UNA cosa, y dos botones del
 * mismo peso no piden ninguna.
 *
 * Los enlaces de texto se muestran desde `xl` (1280 px), no desde `lg`. Con
 * los textos en español —logotipo, cinco enlaces, Contacto, ES/EN y el botón—
 * la barra necesita unos 1,100 px, y a 1024 el botón quedaba fuera de la
 * pantalla. Entre `md` y `xl` se ve el botón y el resto vive en el menú.
 *
 * «Entrar» solo aparece si `negocio.url_app` tiene valor. Un enlace de acceso
 * que no lleva a ningún lado es peor que no tenerlo: quien ya es cliente lo
 * busca primero.
 */
import Wordmark from './Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV_PAGES, path, type Lang, type PageKey } from '../i18n/routes';
import { negocio } from '../config/negocio';
import { agenda } from '../config/enlaces';
import { common } from '../i18n';

interface Props {
  lang: Lang;
  pageKey: PageKey;
}

const { lang, pageKey } = Astro.props;
const c = common(lang);

const items = NAV_PAGES.map((key) => ({
  key,
  href: path(key, lang),
  label: c.nav[key as keyof typeof c.nav] as string,
  current: key === pageKey,
}));

const agendaHref = agenda(lang);
const appHref = negocio.url_app;
---

<header class="sticky top-0 z-50 border-b border-line bg-ground">
  <div class="container-page flex h-16 items-center justify-between gap-5 lg:h-[4.5rem]">
    <a
      href={path('home', lang)}
      class="shrink-0"
      aria-label={`${c.brand.name} — ${c.brand.tagline}`}
    >
      <Wordmark size="nav" />
    </a>

    <!-- `whitespace-nowrap` en cada enlace: «Para contadores y consultores» se
         partía en dos líneas dentro de la barra, y eso descuadraba el subrayado
         de la página activa, que se posiciona contra el borde inferior. -->
    <nav aria-label={c.nav.mainLabel} class="hidden items-center gap-6 xl:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'relative text-sm whitespace-nowrap transition-colors',
              item.current ? 'font-medium text-ink' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
            {item.current && (
              <span
                aria-hidden="true"
                class="absolute -bottom-[1.35rem] left-0 h-[2px] w-full bg-brand"
              />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 lg:gap-4">
      <a
        href={path('contact', lang)}
        aria-current={pageKey === 'contact' ? 'page' : undefined}
        class:list={[
          'hidden text-sm whitespace-nowrap transition-colors xl:inline',
          pageKey === 'contact' ? 'font-medium text-ink' : 'text-muted hover:text-ink',
        ]}
      >
        {c.nav.contact}
      </a>

      {
        appHref && (
          <a
            href={appHref}
            rel="noopener"
            class="hidden text-sm whitespace-nowrap text-muted transition-colors hover:text-ink xl:inline"
          >
            {c.nav.app}
          </a>
        )
      }

      <!-- El selector va SIEMPRE visible, también en móvil: esconder el cambio
           de idioma dentro de la hamburguesa es esconderlo, y el mercado
           inicial es México leyendo un sitio cuyo idioma por defecto es el
           inglés. -->
      <LanguageSwitcher lang={lang} pageKey={pageKey} />

      <a
        href={agendaHref}
        data-cta="agenda"
        class="hidden bg-brand px-4 py-2.5 text-sm font-medium whitespace-nowrap text-white transition-colors hover:bg-brand-text md:inline-flex"
      >
        {c.nav.cta}
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={c.nav.openMenu}
        data-close-label={c.nav.closeMenu}
        class="-mr-2 flex h-10 w-10 items-center justify-center text-ink xl:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- El panel móvil vive en el flujo normal del documento y se oculta con el
       atributo `hidden`, no con una clase: así el contenido no queda alcanzable
       por teclado mientras está cerrado. -->
  <div id="mobile-menu" hidden class="border-t border-line bg-ground xl:hidden">
    <nav aria-label={c.nav.mainLabel} class="container-page flex flex-col py-2">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'border-b border-line py-4 text-base transition-colors',
              item.current ? 'font-medium text-ink' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={path('contact', lang)}
        aria-current={pageKey === 'contact' ? 'page' : undefined}
        class:list={[
          'border-b border-line py-4 text-base transition-colors',
          pageKey === 'contact' ? 'font-medium text-ink' : 'text-muted',
        ]}
      >
        {c.nav.contact}
      </a>
      {
        appHref && (
          <a href={appHref} rel="noopener" class="border-b border-line py-4 text-base text-muted">
            {c.nav.app}
          </a>
        )
      }
      <div class="py-5">
        <a
          href={agendaHref}
          data-cta="agenda"
          class="block bg-brand px-4 py-3.5 text-center text-sm font-medium text-white"
        >
          {c.nav.cta}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const labels = {
      open: toggle.getAttribute('aria-label') ?? 'Open menu',
      close: toggle.dataset.closeLabel ?? toggle.getAttribute('aria-label') ?? 'Close menu',
    };

    toggle.addEventListener('click', () => {
      const willOpen = menu.hasAttribute('hidden');
      menu.toggleAttribute('hidden', !willOpen);
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.setAttribute('aria-label', willOpen ? labels.close : labels.open);
    });

    // Escape cierra y devuelve el foco al botón: sin esto, quien navega con
    // teclado se queda dentro de un menú abierto sin salida obvia.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hasAttribute('hidden')) {
        menu.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', labels.open);
        toggle.focus();
      }
    });
  }
</script>
