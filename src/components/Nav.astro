---
/**
 * Barra de navegación.
 *
 * Un menú por idioma (`NAV_PAGES` en `routes.ts`) y UN botón: «Agenda una
 * llamada» / «Book a call». El sitio pide una sola cosa; dos botones del mismo
 * peso no piden ninguna.
 *
 * Los enlaces de texto se muestran desde `xl` (1280 px). Por debajo, el botón
 * sigue visible y el resto vive en el menú desplegable.
 *
 * El selector de idioma va siempre visible, también en móvil: esconderlo en la
 * hamburguesa es esconderlo.
 *
 * «Entrar» solo aparece si `negocio.url_app` tiene valor.
 */
import Wordmark from './Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV_PAGES, path, type Lang, type PageKey } from '../i18n/routes';
import { negocio } from '../config/negocio';
import { agenda, esExterno } from '../config/enlaces';
import { common } from '../i18n';

interface Props {
  lang: Lang;
  pageKey: PageKey;
}

const { lang, pageKey } = Astro.props;
const c = common(lang);

const items = NAV_PAGES[lang].map((key) => ({
  key,
  href: path(key, lang),
  label: c.nav[key as keyof typeof c.nav] as string,
  // Precios y Plataforma son parte de la línea de asesores: en esas páginas
  // se marca «Para asesores» como sección actual.
  current: key === pageKey || (key === 'advisors' && (pageKey === 'pricing' || pageKey === 'platform')),
}));

const agendaHref = agenda(lang);
const externo = esExterno(agendaHref);
const appHref = negocio.url_app;
---

<header class="sticky top-0 z-50 border-b border-line bg-ground/95 backdrop-blur supports-[backdrop-filter]:bg-ground/85">
  <div class="container-page flex h-16 items-center justify-between gap-5 lg:h-[4.5rem]">
    <a href={path('home', lang)} class="shrink-0 py-2" aria-label={`${c.brand.name} — ${c.nav.home}`}>
      <Wordmark height={36} />
    </a>

    <nav aria-label={c.nav.mainLabel} class="hidden items-center gap-7 xl:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'relative py-2 text-sm whitespace-nowrap transition-colors',
              item.current ? 'font-medium text-ink' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
            {item.current && (
              <span aria-hidden="true" class="absolute -bottom-[0.95rem] left-0 h-[2px] w-full rounded-full bg-brand" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4 lg:gap-5">
      <LanguageSwitcher lang={lang} noteClass="hidden max-w-[11rem] lg:block" />

      {
        appHref && (
          <a
            href={appHref}
            rel="noopener"
            class="hidden text-sm whitespace-nowrap text-muted transition-colors hover:text-ink xl:inline"
          >
            {c.nav.app}
          </a>
        )
      }

      <a
        href={agendaHref}
        data-cta="agenda"
        {...(externo ? { target: '_blank', rel: 'noopener' } : {})}
        class="hidden rounded-control bg-brand px-4 py-2.5 text-sm font-medium whitespace-nowrap text-white transition-colors hover:bg-vino md:inline-flex"
      >
        {c.nav.cta}
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={c.nav.openMenu}
        data-close-label={c.nav.closeMenu}
        class="-mr-2 flex h-11 w-11 items-center justify-center rounded-control text-ink xl:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- El panel móvil vive en el flujo normal del documento y se oculta con el
       atributo `hidden`, no con una clase: así el contenido no queda alcanzable
       por teclado mientras está cerrado. -->
  <div id="mobile-menu" hidden class="border-t border-line bg-ground xl:hidden">
    <nav aria-label={`${c.nav.mainLabel} (menú)`} class="container-page flex flex-col py-2">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'border-b border-line py-4 text-base transition-colors',
              item.current ? 'font-medium text-ink' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={path('contact', lang)}
        aria-current={pageKey === 'contact' ? 'page' : undefined}
        class:list={[
          'border-b border-line py-4 text-base transition-colors',
          pageKey === 'contact' ? 'font-medium text-ink' : 'text-muted',
        ]}
      >
        {c.nav.contact}
      </a>
      {
        appHref && (
          <a href={appHref} rel="noopener" class="border-b border-line py-4 text-base text-muted">
            {c.nav.app}
          </a>
        )
      }
      <p lang={lang === 'es' ? 'en' : 'es-MX'} class="pt-4 text-xs text-muted lg:hidden">{c.lang.note}</p>
      <div class="py-5 md:hidden">
        <a
          href={agendaHref}
          data-cta="agenda"
          {...(externo ? { target: '_blank', rel: 'noopener' } : {})}
          class="block rounded-control bg-brand px-4 py-3.5 text-center text-sm font-medium text-white"
        >
          {c.nav.cta}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const labels = {
      open: toggle.getAttribute('aria-label') ?? 'Open menu',
      close: toggle.dataset.closeLabel ?? toggle.getAttribute('aria-label') ?? 'Close menu',
    };

    toggle.addEventListener('click', () => {
      const willOpen = menu.hasAttribute('hidden');
      menu.toggleAttribute('hidden', !willOpen);
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.setAttribute('aria-label', willOpen ? labels.close : labels.open);
    });

    // Escape cierra y devuelve el foco al botón.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hasAttribute('hidden')) {
        menu.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', labels.open);
        toggle.focus();
      }
    });
  }
</script>
