---
/**
 * Industrias. Rediseño v3.
 *
 * Responde «¿es Forcelis relevante para mi negocio?», y por eso el orden se
 * invierte respecto a la versión anterior:
 *
 *   1. ¿ES PARA TI? — la lista de comprobación (tamaño, etapa, modelo,
 *      mercado) va PRIMERO. Antes era el perfil al final de la página: la
 *      respuesta más útil, en el sitio donde menos gente llega.
 *   2. SECTORES — seis tarjetas con tres etiquetas cada una y el detalle
 *      plegado. Lo que se ve responde la pregunta; lo que se despliega la
 *      profundiza.
 *   3. CONFIGURACIÓN — la nota de que la lógica sectorial vive en
 *      configuración, que es lo que hace creíble «tu sector no está, cuéntanos».
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import Checklist from '../Checklist.astro';
import IndustryCard from '../IndustryCard.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ind = t(lang, 'industries');
---

<Base lang={lang} pageKey="industries" title={ind.meta.title} description={ind.meta.description}>
  <PageHero
    photoKey="industries"
    eyebrow={ind.hero.eyebrow}
    title={ind.hero.title}
    intro={ind.hero.subtitle}
  />

  <!-- ============================================================ ¿ES PARA TI? -->
  <Section tone="ground" size="compact">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-16">
      <div class="reveal">
        <SectionHeader title={ind.fit.title} intro={ind.fit.intro} />
      </div>
      <div class="reveal lg:self-center" data-reveal-delay="80">
        <Checklist items={ind.fit.items.map((text) => ({ text }))} layout="grid" size="large" />
        <p class="mt-6 max-w-[64ch] text-[0.9375rem] leading-relaxed text-muted">{ind.fit.note}</p>
      </div>
    </div>
  </Section>

  <!-- ================================================================ SECTORES -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={ind.sectorsTitle} />
    </div>

    <div class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        ind.sectors.map((sector, i) => (
          <div class="reveal flex" data-reveal-delay={(i % 3) * 70}>
            <IndustryCard
              photoKey={sector.key}
              title={sector.title}
              tags={sector.tags}
              lead={sector.lead}
              points={sector.points}
              detailLabel={ind.detailLabel}
              eager={i < 3}
              class="flex-1"
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ========================================================== CONFIGURACIÓN -->
  <Section tone="ground" size="compact">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {ind.config.title}
      </h2>
      <p class="max-w-3xl text-lg leading-relaxed text-muted">{ind.config.body}</p>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={ind.closing.title}
    body={ind.closing.body}
    primaryLabel={ind.closing.primary}
    primaryTo="contact"
    secondaryLabel={ind.closing.secondary}
    secondaryTo="diagnostic"
  />
</Base>
