---
/**
 * Industrias. Rediseño v2.
 *
 * Cambios respecto a la versión anterior:
 *
 *  1. SECTORES — se conserva la retícula de dos columnas (aquí las tarjetas sí
 *     comunican: son seis objetos comparables entre sí), pero con el título a
 *     tamaño de titular y más aire, y con los puntos como filas regladas en vez
 *     de viñetas diminutas. Antes cabían seis fichas en una pantalla y ninguna
 *     se leía.
 *  2. PERFIL — de cuatro celdas rellenas a una tira de datos colgada de una
 *     regla, con las etiquetas arriba. Es un encabezado de tabla, no cuatro
 *     tarjetas.
 *  3. La nota del perfil deja de ser un recuadro con filo a la izquierda y pasa
 *     a ser prosa: es una frase, no un aviso.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ind = t(lang, 'industries');
---

<Base lang={lang} pageKey="industries" title={ind.meta.title} description={ind.meta.description}>
  <Section tone="ground" size="compact" class="border-b border-line">
    <div class="reveal">
      <SectionHeader
        as="h1"
        eyebrow={ind.hero.eyebrow}
        title={ind.hero.title}
        intro={ind.hero.subtitle}
      />
    </div>
  </Section>

  <!-- ================================================================ SECTORES -->
  <Section tone="ground">
    <div class="grid gap-px border border-line bg-line lg:grid-cols-2">
      {
        ind.sectors.map((sector, i) => (
          <article class="reveal bg-ground p-8 lg:p-10" data-reveal-delay={(i % 2) * 80}>
            <h2 class="text-2xl leading-tight font-semibold tracking-[-0.02em] text-ink lg:text-[1.75rem]">
              {sector.title}
            </h2>
            <p class="mt-4 max-w-[52ch] text-base leading-relaxed text-muted">{sector.lead}</p>
            <ul class="mt-7">
              {sector.points.map((point) => (
                <li class="border-t border-line py-3 text-[0.9375rem] text-ink">{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ================================================================= PERFIL -->
  <Section tone="panel">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-16">
      <div class="reveal">
        <SectionHeader title={ind.profile.title} intro={ind.profile.intro} />
      </div>

      <div class="reveal" data-reveal-delay="90">
        <dl class="grid gap-x-10 border-t-2 border-ink sm:grid-cols-2 lg:grid-cols-4">
          {
            ind.profile.items.map((item, i) => (
              <div
                class:list={[
                  'pt-5 pb-2 lg:pr-8',
                  i < ind.profile.items.length - 1 && 'lg:border-r lg:border-line',
                ]}
              >
                <dt class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {item.label}
                </dt>
                <dd class="mt-2.5 text-lg leading-snug font-semibold text-ink">{item.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-10 max-w-[64ch] border-t border-line pt-6 text-base leading-relaxed text-muted">
          {ind.profile.note}
        </p>
      </div>
    </div>
  </Section>

  <!-- ========================================================== CONFIGURACIÓN -->
  <Section tone="ink" size="compact">
    <div class="reveal max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-on-ink lg:text-3xl">
        {ind.config.title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-on-ink-muted">{ind.config.body}</p>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={ind.closing.title}
    body={ind.closing.body}
    primaryLabel={ind.closing.primary}
    primaryTo="contact"
    secondaryLabel={ind.closing.secondary}
    secondaryTo="diagnostic"
  />
</Base>
