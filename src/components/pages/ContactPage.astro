---
/**
 * Contacto.
 *
 * Responde «¿qué pasa si escribo?». Desde el giro a consultoría hay un camino
 * más corto que el formulario —el calendario— y va ARRIBA, antes de pedirle
 * nada a nadie: quien ya se decidió no debería tener que llenar seis campos
 * para hablar veinte minutos.
 *
 * El formulario queda para quien prefiere escribir primero, y pregunta lo
 * que decide la conversación: giro, sucursales y ciudad.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import Button from '../Button.astro';
import { agenda } from '../../config/enlaces';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const k = t(lang, 'contact');

// Correo de contacto por variable de entorno. Sin ella no se imprime nada: es
// preferible una página sin correo a un correo inventado que rebota.
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const agendaHref = agenda(lang);
---

<Base lang={lang} pageKey="contact" title={k.meta.title} description={k.meta.description}>
  <PageHero
    photoKey="contact"
    eyebrow={k.hero.eyebrow}
    title={k.hero.title}
    intro={k.hero.subtitle}
  />

  <!-- La agenda primero: es el camino corto y no cuesta nada tomarlo. -->
  <Section tone="panel" size="compact">
    <div class="reveal grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-16">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
          {k.schedule.title}
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{k.schedule.body}</p>
      </div>
      <Button href={agendaHref} size="lg" data-cta="agenda">{k.schedule.cta}</Button>
    </div>
  </Section>

  <Section tone="ground">
    <div class="grid gap-14 lg:grid-cols-[1fr_minmax(0,22rem)] lg:gap-20">
      <div class="reveal">
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
          {k.formIntro.title}
        </h2>
        <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{k.formIntro.body}</p>
        <div class="mt-10">
          <ContactForm lang={lang} />
        </div>
      </div>

      <!-- `section` y no `aside`: un `aside` dentro de `main` es una región
           complementaria anidada (axe `landmark-complementary-is-top-level`). -->
      <section class="reveal space-y-12" data-reveal-delay="100" aria-label={k.next.title}>
        <div>
          <h2 class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase">
            {k.next.title}
          </h2>
          <ol class="mt-6 divide-y divide-line border-t border-b border-line">
            {
              k.next.steps.map((step, i) => (
                <li class="grid grid-cols-[2.5rem_1fr] gap-x-2 py-5">
                  <span class="tnum text-2xl leading-none font-semibold tracking-[-0.03em] text-brand-text">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="text-base font-semibold text-ink">{step.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div>
          <h2 class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase">
            {k.assurance.title}
          </h2>
          <ul class="mt-6 space-y-5">
            {
              k.assurance.items.map((item) => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="mt-0.5 shrink-0">
                    <path d="M3.5 9.5 7.5 13.5 14.5 5" stroke="var(--color-brand)" stroke-width="1.8" stroke-linecap="square" />
                  </svg>
                  <div>
                    <p class="text-sm font-semibold tracking-[0.08em] text-ink uppercase">{item.title}</p>
                    <p class="mt-1 text-sm leading-relaxed text-muted">{item.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        {
          contactEmail && (
            <div class="border-t border-line pt-10">
              <a
                href={`mailto:${contactEmail}`}
                class="text-sm font-medium text-brand-text underline underline-offset-4"
              >
                {contactEmail}
              </a>
            </div>
          )
        }
      </section>
    </div>
  </Section>
</Base>
