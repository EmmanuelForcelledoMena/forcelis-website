---
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import ScorePanel from '../ScorePanel.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Cta from '../Cta.astro';
import { path, type Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang, 'diagnostic');
const c = common(lang);

const severityStyles: Record<string, string> = {
  high: 'border-brand text-brand-text',
  medium: 'border-[var(--color-data-amber)] text-[var(--color-data-amber-text)]',
};
---

<Base lang={lang} pageKey="diagnostic" title={d.meta.title} description={d.meta.description}>
  <!-- ================================================================== HERO -->
  <Section tone="ground" size="compact" class="border-b border-line">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,25rem)] lg:gap-16">
      <div class="reveal">
        <SectionHeader as="h1" eyebrow={d.hero.eyebrow} title={d.hero.title} intro={d.hero.subtitle} />
        <div class="mt-10">
          <Button href={path('contact', lang)} size="lg">{d.hero.cta}</Button>
        </div>
      </div>
      <div class="reveal" data-reveal-delay="120">
        <ScorePanel
          title={d.score.title}
          items={d.score.items}
          illustrativeLabel={c.labels.illustrative}
          outOfLabel={c.labels.scoreOutOf}
          footnote={d.score.footnote}
        />
        <p class="mt-5 text-sm leading-relaxed text-muted">{d.score.intro}</p>
      </div>
    </div>
  </Section>

  <!-- ============================================================ QUÉ SE ANALIZA -->
  <Section tone="panel" size="compact">
    <div class="reveal">
      <SectionHeader eyebrow={d.score.eyebrow} title={d.analysis.title} intro={d.analysis.intro} />
    </div>

    <div class="mt-14">
      <div class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          d.analysis.areas.map((area, i) => (
            <div class="reveal bg-panel p-6" data-reveal-delay={i * 70}>
              <h3 class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
                {area.title}
              </h3>
              <ul class="mt-4 space-y-2.5">
                {area.items.map((item) => (
                  <li class="text-[0.9375rem] text-muted">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- =============================================================== HALLAZGOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={d.findings.eyebrow} title={d.findings.title} intro={d.findings.intro} />
    </div>

    <ol class="mt-14 space-y-5">
      {
        d.findings.items.map((finding, i) => (
          <li class="reveal border border-line bg-panel p-7 lg:p-8" data-reveal-delay={i * 60}>
            <div class="flex flex-wrap items-center gap-4">
              <span
                class:list={[
                  'border px-2.5 py-1 text-[0.625rem] font-semibold tracking-[0.12em] uppercase',
                  severityStyles[finding.severity],
                ]}
              >
                {finding.severityLabel}
              </span>
              <span class="tnum text-xs font-medium text-muted">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="mt-5 text-lg leading-snug font-semibold text-ink lg:text-xl">
              {finding.title}
            </h3>
            <p class="mt-3 max-w-3xl text-[0.9375rem] leading-relaxed text-muted">{finding.body}</p>
            <div class="mt-5 flex items-start gap-3 border-t border-line pt-5">
              <Icon name="arrowRight" class="mt-0.5 h-4 w-4 shrink-0 text-brand-text" />
              <p class="text-[0.9375rem] font-medium text-ink">{finding.action}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============================================================ ENTREGABLES -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader
        eyebrow={d.deliverables.eyebrow}
        title={d.deliverables.title}
        tone="light"
      />
    </div>

    <div class="mt-14 grid gap-px border border-line-ink bg-line-ink sm:grid-cols-2 lg:grid-cols-3">
      {
        d.deliverables.items.map((item, i) => (
          <div class="reveal bg-ink p-7 lg:p-8" data-reveal-delay={(i % 3) * 70}>
            <span class="tnum text-xs font-semibold text-brand">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-lg font-semibold text-on-ink">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-on-ink-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ================================================================ PROCESO -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={d.process.eyebrow} title={d.process.title} />
    </div>

    <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        d.process.steps.map((step, i) => (
          <li class="reveal border-t-2 border-ink bg-panel p-6" data-reveal-delay={i * 70}>
            <span class="tnum text-xs font-semibold text-brand-text">{step.num}</span>
            <h3 class="mt-3 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-16 grid gap-10 border-t border-line pt-14 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div>
        <h3 class="text-xl font-semibold text-ink">{d.inputs.title}</h3>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{d.inputs.intro}</p>
      </div>
      <div>
        <ul class="divide-y divide-line border-t border-b border-line">
          {
            d.inputs.items.map((item) => (
              <li class="flex items-start gap-3 py-4 text-[0.9375rem] text-ink">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-text" />
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm text-muted italic">{d.inputs.note}</p>
      </div>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={d.closing.title}
    body={d.closing.body}
    primaryLabel={d.closing.primary}
    primaryTo="contact"
    secondaryLabel={d.closing.secondary}
    secondaryTo="platform"
  />
</Base>
