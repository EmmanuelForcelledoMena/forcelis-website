---
/**
 * Diagnóstico Empresarial. Rediseño v3: página de PRODUCTO.
 *
 * Responde «¿qué recibo exactamente?». El orden es el de una compra:
 *
 *   1. HERO — la promesa y el objeto: el score es el visual principal y va
 *      en el hero, no tres secciones más abajo.
 *   2. QUÉ VAMOS A ENCONTRAR — cuatro hallazgos como tarjetas con la misma
 *      anatomía (prioridad · hallazgo · por qué importa · acción). Antes eran
 *      filas de tres columnas; en tarjeta cada uno se lee como una unidad.
 *   3. QUÉ RECIBES — el informe dibujado (portada con score e índice de seis
 *      secciones) junto a la lista de secciones. Antes era una lista reglada
 *      sobre tinta; ahora se VE que es un documento.
 *   4. CÓMO FUNCIONA — cuatro pasos y, al mismo nivel, lo que más pesa para
 *      quien decide: sin acceso a sistemas, los archivos los exportas tú.
 *   5. QUÉ HACE FALTA — lista de comprobación con «Requerido»/«Opcional».
 *
 * «Qué se analiza» (25 indicadores) sigue en la página, plegado bajo el
 * score: es información de alcance, no de decisión.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import ScorePanel from '../ScorePanel.astro';
import InsightCard from '../InsightCard.astro';
import ReportPreview from '../ReportPreview.astro';
import ProcessSteps from '../ProcessSteps.astro';
import Checklist from '../Checklist.astro';
import Disclosure from '../Disclosure.astro';
import Tag from '../Tag.astro';
import Cta from '../Cta.astro';
import { path, type Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang, 'diagnostic');
const c = common(lang);

// La misma cifra que enseña el panel: media de las cinco dimensiones.
const overall = Math.round(c.scores.reduce((sum, s) => sum + s.value, 0) / c.scores.length);
---

<Base lang={lang} pageKey="diagnostic" title={d.meta.title} description={d.meta.description}>
  <!-- ================================================================== HERO -->
  <PageHero
    photoKey="diagnostic"
    eyebrow={d.hero.eyebrow}
    title={d.hero.title}
    intro={d.hero.subtitle}
    cta={{ href: path('contact', lang), label: d.hero.cta }}
  >
    <div class="reveal lg:self-center" data-reveal-delay="120">
      <ScorePanel
        title={d.score.title}
        items={c.scores}
        illustrativeLabel={c.labels.illustrative}
        outOfLabel={c.labels.scoreOutOf}
        overallLabel={c.labels.overallScore}
        overallNote={c.labels.overallNote}
        footnote={d.score.footnote}
      />
    </div>
  </PageHero>

  <!-- ========================================================= QUÉ SE ANALIZA -->
  <section class="border-b border-line bg-ground">
    <div class="container-page grid gap-8 py-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16 lg:py-12">
      <p class="reveal text-[0.9375rem] leading-relaxed text-muted lg:text-base">{d.score.intro}</p>
      <div class="reveal border-b border-line" data-reveal-delay="80">
        <Disclosure summary={d.analysis.title} meta={d.analysis.meta}>
          <!-- Los títulos de área son etiquetas, no encabezados: el bloque
               cuelga de un resumen plegable y un h3 aquí saltaría del h1 del
               hero directamente al h3. -->
          <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
            {
              d.analysis.areas.map((area) => (
                <div>
                  <p class="text-[0.6875rem] font-semibold tracking-[0.14em] text-ink uppercase">
                    {area.title}
                  </p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {area.items.map((item) => (
                      <li>
                        <Tag>{item}</Tag>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </Disclosure>
      </div>
    </div>
  </section>

  <!-- ============================================================= HALLAZGOS -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={d.findings.eyebrow} title={d.findings.title} intro={d.findings.intro} />
    </div>

    <div class="mt-14 grid gap-px border border-line bg-line sm:grid-cols-2">
      {
        d.findings.items.map((item, i) => (
          <div class="reveal flex" data-reveal-delay={(i % 2) * 80}>
            <InsightCard
              severity={item.severity}
              severityLabel={item.severityLabel}
              title={item.title}
              body={item.body}
              action={item.action}
              whyLabel={c.labels.whyItMatters}
              actionLabel={c.labels.recommendedAction}
              class="flex-1"
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ============================================================ QUÉ RECIBES -->
  <Section tone="ground" id="deliverables">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,26rem)_1fr] lg:items-center lg:gap-24">
      <div class="reveal" data-reveal-delay="100">
        <ReportPreview
          docLabel={d.deliverables.report.docLabel}
          docMeta={d.deliverables.report.docMeta}
          scoreLabel={d.deliverables.report.scoreLabel}
          score={overall}
          sections={d.deliverables.items.map((item) => item.title)}
          alt={d.deliverables.report.alt}
        />
      </div>

      <div class="reveal">
        <SectionHeader
          eyebrow={d.deliverables.eyebrow}
          title={d.deliverables.title}
          intro={d.deliverables.intro}
        />
        <ol class="mt-10 divide-y divide-line border-t border-b border-line">
          {
            d.deliverables.items.map((item, i) => (
              <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-[2rem_minmax(0,14rem)_1fr] sm:items-baseline">
                <span class="tnum text-xs font-semibold text-brand-text">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="text-base font-semibold text-ink">{item.title}</h3>
                <p class="text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Section>

  <!-- ================================================================ PROCESO -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader eyebrow={d.process.eyebrow} title={d.process.title} tone="light" />
    </div>

    <ProcessSteps items={d.process.steps} tone="light" class="mt-14" />

    <!-- Las tres garantías al mismo nivel que los pasos, no como pie de nota:
         son lo primero que pregunta quien decide si manda información. -->
    <ul class="reveal mt-12 grid gap-px border border-line-ink bg-line-ink sm:grid-cols-3" data-reveal-delay="120">
      {
        d.process.assurances.map((item) => (
          <li class="flex items-center gap-4 bg-ink px-6 py-5">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="shrink-0">
              <path d="M3.5 9.5 7.5 13.5 14.5 5" stroke="var(--color-on-ink-muted)" stroke-width="1.8" stroke-linecap="square" />
            </svg>
            <span class="text-sm font-semibold tracking-[0.06em] text-on-ink uppercase">{item}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ================================================================ INSUMOS -->
  <Section tone="panel" size="compact">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div class="reveal">
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">{d.inputs.title}</h2>
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{d.inputs.intro}</p>
      </div>
      <div class="reveal" data-reveal-delay="80">
        <Checklist
          items={d.inputs.items.map((item) => ({
            text: item.text,
            tag: item.required ? c.labels.required : c.labels.optional,
            tagTone: item.required ? 'brand' : 'ink',
          }))}
        />
        <p class="mt-5 text-sm text-muted italic">{d.inputs.note}</p>
      </div>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={d.closing.title}
    body={d.closing.body}
    primaryLabel={d.closing.primary}
    primaryTo="contact"
    secondaryLabel={d.closing.secondary}
    secondaryTo="platform"
  />
</Base>
