---
/**
 * Diagnóstico Empresarial. Rediseño v2.
 *
 * Cambios respecto a la versión anterior:
 *
 *  1. QUÉ SE ANALIZA — de cuatro celdas rellenas a cuatro columnas separadas
 *     solo por una línea. El contenido es una lista de términos por área; el
 *     relleno de la celda no aportaba nada y multiplicaba bordes por cuatro.
 *  2. HALLAZGOS — de cuatro tarjetas apiladas a filas de tres columnas
 *     (severidad · hallazgo · acción). La acción recomendada era un pie de nota
 *     detrás de una regla; ahora es una columna propia que se puede recorrer
 *     entera. Es la promesa central de la página.
 *  3. ENTREGABLES — de seis celdas sobre tinta a filas regladas numeradas.
 *  4. PROCESO — de cuatro tarjetas a línea de tiempo.
 *
 * El panel de score y la lista de insumos se conservan: son dato tabulado y
 * lista de requisitos, y ahí el marco sí ayuda a leer.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import ScorePanel from '../ScorePanel.astro';
import FindingRows from '../FindingRows.astro';
import RuledRows from '../RuledRows.astro';
import Timeline from '../Timeline.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Cta from '../Cta.astro';
import { path, type Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang, 'diagnostic');
const c = common(lang);
---

<Base lang={lang} pageKey="diagnostic" title={d.meta.title} description={d.meta.description}>
  <!-- ================================================================== HERO -->
  <Section tone="ground" size="compact" class="border-b border-line">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,25rem)] lg:gap-16">
      <div class="reveal">
        <SectionHeader as="h1" eyebrow={d.hero.eyebrow} title={d.hero.title} intro={d.hero.subtitle} />
        <div class="mt-10">
          <Button href={path('contact', lang)} size="lg">{d.hero.cta}</Button>
        </div>
      </div>
      <div class="reveal" data-reveal-delay="120">
        <ScorePanel
          title={d.score.title}
          items={d.score.items}
          illustrativeLabel={c.labels.illustrative}
          outOfLabel={c.labels.scoreOutOf}
          footnote={d.score.footnote}
        />
        <p class="mt-5 text-sm leading-relaxed text-muted">{d.score.intro}</p>
      </div>
    </div>
  </Section>

  <!-- ============================================================ QUÉ SE ANALIZA -->
  <Section tone="panel" size="compact">
    <div class="reveal">
      <SectionHeader eyebrow={d.score.eyebrow} title={d.analysis.title} intro={d.analysis.intro} />
    </div>

    <div class="mt-14 grid gap-x-10 gap-y-10 border-t-2 border-ink sm:grid-cols-2 lg:grid-cols-4">
      {
        d.analysis.areas.map((area, i) => (
          <div
            class:list={[
              'reveal pt-6 lg:pr-10',
              i < d.analysis.areas.length - 1 && 'lg:border-r lg:border-line',
            ]}
            data-reveal-delay={i * 70}
          >
            <h3 class="text-base font-semibold text-ink">{area.title}</h3>
            <ul class="mt-5">
              {area.items.map((item) => (
                <li class="border-t border-line py-2.5 text-[0.9375rem] text-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- =============================================================== HALLAZGOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={d.findings.eyebrow} title={d.findings.title} intro={d.findings.intro} />
    </div>

    <FindingRows items={d.findings.items} actionLabel={d.findings.actionLabel} class="mt-14" />
  </Section>

  <!-- ============================================================ ENTREGABLES -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader
        eyebrow={d.deliverables.eyebrow}
        title={d.deliverables.title}
        tone="light"
      />
    </div>

    <RuledRows
      items={d.deliverables.items.map((item) => ({ term: item.title, body: item.body }))}
      numbered
      tone="light"
      termWidth="wide"
      class="mt-14"
    />
  </Section>

  <!-- ================================================================ PROCESO -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={d.process.eyebrow} title={d.process.title} />
    </div>

    <Timeline
      items={d.process.steps.map((step) => ({ title: step.title, body: step.body }))}
      class="mt-14"
    />

    <div class="reveal mt-16 grid gap-10 border-t border-line pt-14 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div>
        <h3 class="text-xl font-semibold text-ink lg:text-2xl">{d.inputs.title}</h3>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{d.inputs.intro}</p>
      </div>
      <div>
        <ul class="divide-y divide-line border-t border-b border-line">
          {
            d.inputs.items.map((item) => (
              <li class="flex items-start gap-3 py-4 text-[0.9375rem] text-ink">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-text" />
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm text-muted italic">{d.inputs.note}</p>
      </div>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={d.closing.title}
    body={d.closing.body}
    primaryLabel={d.closing.primary}
    primaryTo="contact"
    secondaryLabel={d.closing.secondary}
    secondaryTo="platform"
  />
</Base>
