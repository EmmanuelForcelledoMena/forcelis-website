---
/**
 * Precios de la plataforma (`/es/precios/`), dentro de la línea de asesores.
 *
 * Orden: la oferta de lanzamiento (arriba, destacada) → los tres planes para
 * asesores → Individual y Enterprise → la comparación lado a lado → notas →
 * preguntas → un enlace a los servicios de consultoría, que NO se repiten
 * aquí: tienen su propia página.
 *
 * Todo importe, límite y condición sale de `negocio.ts`. La comparación es una
 * tabla de verdad —`<table>` con `<caption>` y `<th scope>`—, desplazable de
 * lado en móvil dentro de una región enfocable, con la primera columna fija.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import PlanCard from '../PlanCard.astro';
import FaqList from '../FaqList.astro';
import Cta from '../Cta.astro';
import { negocio, plan as planPorId, precio, porcentaje, type Plan } from '../../config/negocio';
import { agenda, pedirPrueba, solicitarPlan } from '../../config/enlaces';
import { path } from '../../i18n/routes';
import { es } from '../../i18n';

const lang = 'es';
const p = es('pricing');
const mostrar = negocio.mostrar_precios;
const o = negocio.oferta_lanzamiento;
const numero = new Intl.NumberFormat('es-MX');
const adicional = precio(negocio.empresa_adicional, lang);
const usoJusto = numero.format(negocio.uso_justo_cfdi_por_empresa_mes);

const rellenar = (texto: string) =>
  texto
    .replaceAll('{months}', String(o.meses_gratis))
    .replaceAll('{plan}', p.plans[o.plan].name)
    .replaceAll('{n}', String(o.cupo))
    .replaceAll('{discount}', porcentaje(o.descuento_despues))
    .replaceAll('{discountMonths}', String(o.meses_descuento))
    .replaceAll('{price}', adicional);

const prueba = pedirPrueba();
const etiquetas = {
  companies: p.labels.companies,
  unlimited: p.labels.unlimited,
  quote: p.labels.quote,
  ...p.card,
};
const planesAsesor = ['profesional', 'despacho', 'firma'] as const;
const preguntas = p.faq.items
  .filter((item) => mostrar || !item.a.includes('{price}'))
  .map((item) => ({ q: item.q, a: rellenar(item.a) }));

type Id = Plan['id'];
const valorPrecio = (id: Id) => {
  const pl = planPorId(id);
  return pl.precio === null ? p.labels.quote : precio(pl.precio, lang);
};
const valorEmpresas = (id: Id) => {
  const pl = planPorId(id);
  return pl.empresas === null ? p.labels.unlimited : numero.format(pl.empresas);
};
const valorAdicional = (id: Id) => {
  const pl = planPorId(id);
  if (pl.precio === null) return p.compare.agreed;
  if (!pl.admite_adicionales) return p.compare.notAllowed;
  return p.compare.perCompany.replace('{price}', adicional);
};
const valorUso = (id: Id) =>
  planPorId(id).precio === null ? p.compare.agreed : p.compare.fairUseValue.replace('{n}', usoJusto);

const filas: { label: string; valor: (id: Id) => string; muted?: boolean; fuerte?: boolean }[] = [
  { label: p.compare.rows.for, valor: (id) => p.plans[id].for, muted: true },
  ...(mostrar ? [{ label: p.compare.rows.price, valor: valorPrecio, fuerte: true }] : []),
  { label: p.compare.rows.companies, valor: valorEmpresas, fuerte: true },
  ...(mostrar ? [{ label: p.compare.rows.extra, valor: valorAdicional }] : []),
  {
    label: p.compare.rows.brand,
    valor: (id) => {
      const marca = planPorId(id).marca_propia;
      // La marca del asesor no está verificada en el producto: donde la
      // configuración la marca como incluida se publica «Por confirmar».
      return marca === null ? p.compare.agreed : marca ? p.compare.toConfirm : p.labels.no;
    },
  },
  { label: p.compare.rows.fairUse, valor: valorUso },
];

const celda = 'px-4 py-3.5 text-[0.9375rem] text-ink align-top';
const encabezado = 'px-4 py-3 text-left text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase';
const primeraColumna =
  'sticky left-0 z-10 w-44 min-w-[9rem] bg-panel px-4 py-3.5 text-left text-[0.8125rem] font-medium text-muted align-top';
---

<Base lang={lang} pageKey="pricing" title={p.meta.title} description={rellenar(p.meta.description)}>
  <PageHero tone="dark" photoKey="pricing" eyebrow={p.hero.eyebrow} title={p.hero.title} intro={p.hero.subtitle} />

  <!-- ================================================================ OFERTA -->
  <Section tone="ground" id="oferta" size="compact">
    <div class="reveal overflow-hidden rounded-card border-2 border-brand bg-panel">
      <div class="grid gap-10 p-7 lg:grid-cols-[1.2fr_1fr] lg:gap-14 lg:p-10">
        <div>
          <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">{p.offer.eyebrow}</p>
          <h2 class="mt-3 text-[2rem] leading-tight font-medium tracking-[-0.01em] text-brand lg:text-[2.75rem]">
            {rellenar(p.offer.title)}
          </h2>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{rellenar(p.offer.body)}</p>
          <div class="mt-8">
            <Button href={prueba} size="lg">{rellenar(p.offer.cta)}</Button>
          </div>
        </div>
        <div class="space-y-6 lg:border-l lg:border-line lg:pl-14">
          <div>
            <h3 class="text-sm font-semibold text-ink">{p.offer.exchangeTitle}</h3>
            <ul class="mt-3 space-y-2.5">
              {
                p.offer.exchange.map((linea) => (
                  <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink">
                    <span aria-hidden="true" class="mt-2.5 block h-[2px] w-3 shrink-0 bg-brand" />
                    {linea}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-control bg-panel-alt px-5 py-4">
            <h3 class="text-sm font-semibold text-ink">{p.offer.afterTitle}</h3>
            <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{rellenar(p.offer.after)}</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- =============================================================== ASESORES -->
  <Section tone="panel" id="asesores">
    <div class="reveal">
      <SectionHeader eyebrow={p.advisors.eyebrow} title={p.advisors.title} intro={p.advisors.intro} />
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        planesAsesor.map((id, i) => (
          <div class="reveal flex" data-reveal-delay={i * 70}>
            <PlanCard
              plan={planPorId(id)}
              nombre={p.plans[id].name}
              paraQuien={p.plans[id].for}
              resumen={p.plans[id].summary}
              cta={id === o.plan ? rellenar(p.offer.cta) : p.card.request}
              href={id === o.plan ? prueba : solicitarPlan(id, lang)}
              labels={etiquetas}
              lang={lang}
              destacado={id === o.plan ? rellenar(p.card.offerBadge) : undefined}
              class="flex-1"
            />
          </div>
        ))
      }
    </div>
    {
      mostrar && (
        <a
          href={`${path('advisors', lang)}#margen`}
          class="reveal mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
        >
          {p.advisors.calculator}
        </a>
      )
    }
  </Section>

  <!-- ===================================================== INDIVIDUAL Y MÁS -->
  <Section tone="ground" size="compact">
    <div class="reveal">
      <h2 class="text-2xl font-medium tracking-[-0.01em] text-ink lg:text-3xl">{p.others.title}</h2>
    </div>
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="reveal flex">
        <PlanCard
          plan={planPorId('individual')}
          nombre={p.plans.individual.name}
          paraQuien={p.plans.individual.for}
          resumen={p.plans.individual.summary}
          cta={p.others.individualCta}
          href={solicitarPlan('individual', lang)}
          labels={etiquetas}
          lang={lang}
          class="flex-1"
        />
      </div>
      <div class="reveal flex" data-reveal-delay="70">
        <PlanCard
          plan={planPorId('enterprise')}
          nombre={p.plans.enterprise.name}
          paraQuien={p.plans.enterprise.for}
          resumen={p.plans.enterprise.summary}
          cta={p.others.enterpriseCta}
          href={solicitarPlan('enterprise', lang)}
          labels={etiquetas}
          lang={lang}
          class="flex-1"
        />
      </div>
    </div>
  </Section>

  <!-- ============================================================ COMPARACIÓN -->
  <Section tone="panel" id="comparacion">
    <div class="reveal">
      <SectionHeader eyebrow={p.compare.eyebrow} title={p.compare.title} />
    </div>
    <div
      class="reveal mt-10 overflow-x-auto rounded-card border border-line"
      data-reveal-delay="80"
      role="region"
      tabindex="0"
      aria-label={p.compare.caption}
    >
      <table class="w-full min-w-[52rem] border-collapse bg-panel">
        <caption class="sr-only">{p.compare.caption}</caption>
        <thead>
          <tr class="border-b-2 border-ink">
            <td class={`${encabezado} sticky left-0 z-10 bg-panel`}></td>
            {
              negocio.planes.map((pl) => (
                <th scope="col" class:list={[encabezado, pl.id === o.plan && 'text-brand-text']}>
                  {p.plans[pl.id].name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            filas.map((fila) => (
              <tr>
                <th scope="row" class={primeraColumna}>
                  {fila.label}
                </th>
                {negocio.planes.map((pl) => (
                  <td class:list={[celda, 'tnum', fila.muted && 'text-muted', fila.fuerte && 'font-semibold']}>
                    {fila.valor(pl.id)}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <ul class="reveal mt-6 space-y-1.5 text-sm text-muted">
      {mostrar && <li>{p.notes.extra.replace('{price}', adicional)}</li>}
      <li>{p.notes.fairUse.replace('{n}', usoJusto)}</li>
      <li>{p.notes.tax}</li>
    </ul>
  </Section>

  <!-- ============================================================= PREGUNTAS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={p.faq.title} />
    </div>
    <FaqList items={preguntas} class="reveal mt-10" />

    <div class="reveal mt-14 grid gap-6 rounded-card border border-line bg-panel p-7 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12">
      <div>
        <h2 class="text-xl font-medium text-ink">{p.services.title}</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{p.services.body}</p>
      </div>
      <Button href={path('services', lang)} variant="secondary">{p.services.cta}</Button>
    </div>
  </Section>

  <Cta
    tone="dark"
    title={p.closing.title}
    body={p.closing.body}
    primary={{ href: agenda(lang, 'asesor'), label: p.closing.primary }}
    secondary={{ href: path('platform', lang), label: p.closing.secondary }}
  />
</Base>
