---
/**
 * Precios.
 *
 * La página responde, en este orden: cómo está organizada la oferta, cuánto
 * cuesta el plan para una empresa, cuánto cuestan los planes para asesores,
 * en qué se diferencian, qué no cambia, y —aparte, con otro fondo— qué
 * servicios profesionales existen. El visitante tiene que poder elegir un plan
 * sin hablar con nadie; la demostración es una opción, no la puerta.
 *
 * Todo importe, límite y condición sale de `negocio.ts`. Lo que la
 * configuración define de cada plan es su capacidad (empresas incluidas, si
 * admite adicionales, uso justo) y si los entregables llevan la marca del
 * asesor; eso es lo que se compara. No hay funciones por plan porque la
 * configuración no las define, y la página no las inventa.
 *
 * Mientras `negocio.mostrar_precios` sea `false` esta página existe pero no se
 * enlaza, no entra al sitemap y se sirve con `noindex` (lo decide `routes.ts`),
 * y no imprime ni un importe.
 *
 * La comparación es una tabla de verdad —`<table>` con `<caption>` y `<th
 * scope>`—: en un lector de pantalla la diferencia es poder preguntar «¿qué dice
 * la columna Despacho en la fila Empresas incluidas?». En móvil se desplaza de
 * lado dentro de una región enfocable, con la primera columna fija.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import PlanCard from '../PlanCard.astro';
import FaqList from '../FaqList.astro';
import { negocio, plan as planPorId, precio } from '../../config/negocio';
import { agenda, contacto, solicitarPlan } from '../../config/enlaces';
import { path, type Lang } from '../../i18n/routes';
import { t } from '../../i18n';
import { preciosServicios, ORDEN_SERVICIOS } from '../../i18n/servicios';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang, 'pricing');
const sv = t(lang, 'services');
const preciosSv = preciosServicios(lang);

const mostrar = negocio.mostrar_precios;

const rellenar = (plantilla: string, valores: Record<string, string>) =>
  Object.entries(valores).reduce((s, [k, v]) => s.replace(`{${k}}`, v), plantilla);

const numero = new Intl.NumberFormat(lang === 'es' ? 'es-MX' : 'en-US');
const adicional = mostrar ? precio(negocio.empresa_adicional, lang) : '';

const etiquetas = {
  companies: p.platform.columns.companies,
  unlimited: p.platform.unlimited,
  quote: p.platform.quote,
  ...p.card,
};

const planesAsesor = ['profesional', 'despacho', 'firma'] as const;

// Las preguntas que mencionan el importe de la empresa adicional lo reciben
// formateado; con los precios apagados esa respuesta no se publica.
const preguntas = p.faq.items
  .filter((item) => mostrar || !item.a.includes('{price}'))
  .map((item) => ({ q: item.q, a: rellenar(item.a, { price: adicional }) }));

const celda = 'px-4 py-3.5 text-[0.9375rem] text-ink align-top';
const encabezado =
  'px-4 py-3 text-left text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase';
const primeraColumna =
  'sticky left-0 z-10 w-44 min-w-[9rem] bg-panel px-4 py-3.5 text-left text-[0.8125rem] font-medium text-muted align-top';

const valorPrecio = (id: (typeof negocio.planes)[number]['id']) => {
  const pl = planPorId(id);
  return pl.precio === null ? p.platform.quote : precio(pl.precio, lang);
};
const valorEmpresas = (id: (typeof negocio.planes)[number]['id']) => {
  const pl = planPorId(id);
  return pl.empresas === null ? p.platform.unlimited : numero.format(pl.empresas);
};
const valorAdicional = (id: (typeof negocio.planes)[number]['id']) => {
  const pl = planPorId(id);
  if (pl.precio === null) return p.compare.agreed;
  if (!pl.admite_adicionales) return p.compare.notAllowed;
  return rellenar(p.compare.perCompany, { price: adicional });
};
const valorUso = (id: (typeof negocio.planes)[number]['id']) =>
  planPorId(id).precio === null
    ? p.compare.agreed
    : rellenar(p.compare.fairUseValue, { n: numero.format(negocio.uso_justo_cfdi_por_empresa_mes) });

const filas = [
  { label: p.compare.rows.for, valor: (id: (typeof negocio.planes)[number]['id']) => p.plans[id].for, muted: true },
  ...(mostrar ? [{ label: p.compare.rows.price, valor: valorPrecio, fuerte: true }] : []),
  { label: p.compare.rows.companies, valor: valorEmpresas, fuerte: true },
  ...(mostrar ? [{ label: p.compare.rows.extra, valor: valorAdicional }] : []),
  {
    label: p.compare.rows.brand,
    valor: (id: (typeof negocio.planes)[number]['id']) => {
      const marca = planPorId(id).marca_propia;
      // La marca del asesor no está verificada en el producto: donde la
      // configuración la marca como incluida se publica «Por confirmar».
      return marca === null ? p.compare.agreed : marca ? p.compare.toConfirm : p.platform.no;
    },
  },
  { label: p.compare.rows.fairUse, valor: valorUso },
];
---

<Base lang={lang} pageKey="pricing" title={p.meta.title} description={p.meta.description}>
  <PageHero photoKey="pricing" eyebrow={p.hero.eyebrow} title={p.hero.title} intro={p.hero.subtitle} />

  <!-- ============================================================ ESTRUCTURA -->
  <section class="border-b border-line bg-ground" aria-labelledby="estructura">
    <div class="container-page py-10 lg:py-12">
      <h2 id="estructura" class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
        {p.structure.label}
      </h2>
      <ol class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-8">
        {
          p.structure.items.map((item, i) => (
            <li class="border-t-2 border-ink pt-4">
              <p class="tnum text-[0.6875rem] font-semibold text-brand-text">{String(i + 1).padStart(2, '0')}</p>
              <p class="mt-2 text-base font-semibold text-ink">{item.title}</p>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================== EMPRESAS -->
  <Section tone="ground" id="empresas">
    <div class="grid gap-10 lg:grid-cols-[1fr_minmax(0,24rem)] lg:items-start lg:gap-16">
      <div class="reveal">
        <SectionHeader eyebrow={p.business.eyebrow} title={p.business.title} intro={p.business.intro} />
        <p class="mt-6 max-w-xl text-[0.9375rem] leading-relaxed text-muted">{p.business.accountant}</p>
        <a
          href={path('business', lang)}
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
        >
          {p.business.more}
        </a>
      </div>
      <div class="reveal flex border border-line" data-reveal-delay="80">
        <PlanCard
          plan={planPorId('individual')}
          nombre={p.plans.individual.name}
          paraQuien={p.plans.individual.for}
          resumen={p.plans.individual.summary}
          cta={p.card.request}
          href={solicitarPlan('individual', lang)}
          labels={etiquetas}
          lang={lang}
          class="flex-1"
        />
      </div>
    </div>
  </Section>

  <!-- =============================================================== ASESORES -->
  <Section tone="panel" id="asesores">
    <div class="reveal">
      <SectionHeader eyebrow={p.advisors.eyebrow} title={p.advisors.title} intro={p.advisors.intro} />
    </div>

    <div class="mt-12 grid gap-px border border-line bg-line lg:grid-cols-3">
      {
        planesAsesor.map((id, i) => (
          <div class="reveal flex" data-reveal-delay={i * 70}>
            <PlanCard
              plan={planPorId(id)}
              nombre={p.plans[id].name}
              paraQuien={p.plans[id].for}
              resumen={p.plans[id].summary}
              cta={p.card.request}
              href={solicitarPlan(id, lang)}
              labels={etiquetas}
              lang={lang}
              class="flex-1"
            />
          </div>
        ))
      }
    </div>

    <!-- Enterprise: se cotiza. No tiene precio ni mínimo publicados, ni
         funciones propias: es una forma de contratar la misma plataforma para
         lo que no cabe en los planes publicados. -->
    <div id="enterprise" class="reveal mt-8 grid scroll-mt-24 gap-8 border border-line bg-panel p-7 lg:grid-cols-[1fr_minmax(0,16rem)_minmax(0,17rem)] lg:gap-10 lg:p-9">
      <div>
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">{p.enterprise.eyebrow}</p>
        <h3 class="mt-2 text-xl leading-snug font-semibold tracking-[-0.02em] text-ink">{p.enterprise.title}</h3>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{p.enterprise.body}</p>
      </div>
      <div>
        <p class="text-[0.8125rem] font-medium text-muted">{p.enterprise.basisTitle}</p>
        <ul class="mt-3 space-y-2 text-[0.9375rem] text-ink">
          {p.enterprise.basis.map((linea) => (
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="mt-2.5 block h-[2px] w-3 shrink-0 bg-brand"></span>
              {linea}
            </li>
          ))}
        </ul>
      </div>
      <div class="flex flex-col gap-4 lg:border-l lg:border-line lg:pl-10">
        {mostrar && <p class="text-xl font-semibold tracking-[-0.01em] text-ink">{p.platform.quote}</p>}
        <p class="text-sm leading-relaxed text-muted">{p.enterprise.note}</p>
        <div>
          <Button href={solicitarPlan('enterprise', lang)} variant="primary">{p.card.requestQuote}</Button>
        </div>
      </div>
    </div>

    {
      mostrar && (
        <a
          href={`${path('advisors', lang)}#margen`}
          class="reveal mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
        >
          {p.advisors.calculator}
        </a>
      )
    }
  </Section>

  <!-- ============================================================ COMPARACIÓN -->
  <Section tone="ground" id="comparacion">
    <div class="reveal">
      <SectionHeader eyebrow={p.compare.eyebrow} title={p.compare.title} />
    </div>

    <!-- `tabindex` y `role="region"`: en móvil la tabla se desplaza de lado, y
         quien navega con teclado tiene que poder enfocar la zona para moverla. -->
    <div
      class="reveal mt-10 overflow-x-auto border border-line"
      data-reveal-delay="80"
      role="region"
      tabindex="0"
      aria-label={p.compare.caption}
    >
      <table class="w-full min-w-[52rem] border-collapse bg-panel">
        <caption class="sr-only">{p.compare.caption}</caption>
        <thead>
          <tr class="border-b-2 border-ink">
            <td class={`${encabezado} sticky left-0 z-10 bg-panel`}></td>
            {
              negocio.planes.map((pl) => (
                <th scope="col" class:list={[encabezado, pl.id === 'despacho' && 'text-brand-text']}>
                  {p.plans[pl.id].name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            filas.map((fila) => (
              <tr>
                <th scope="row" class={primeraColumna}>
                  {fila.label}
                </th>
                {negocio.planes.map((pl) => (
                  <td
                    class:list={[
                      celda,
                      'tnum',
                      fila.muted && 'text-muted',
                      fila.fuerte && 'font-semibold',
                    ]}
                  >
                    {fila.valor(pl.id)}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="reveal mt-10 grid gap-6 border-t border-line pt-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <h2 class="text-lg font-semibold tracking-[-0.01em] text-ink">{p.shared.title}</h2>
      <div>
        <ul class="space-y-2 text-[0.9375rem] text-ink">
          {p.shared.items.map((item) => <li>{item}</li>)}
          {negocio.prueba_disponible && <li>{p.platform.trial}</li>}
        </ul>
        <a
          href={path('platform', lang)}
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
        >
          {p.shared.platform}
        </a>
      </div>
    </div>
  </Section>

  <!-- ============================================================ FUNDADORES -->
  <Section tone="ink" size="compact">
    <div class="reveal grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-16">
      <div>
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-on-ink-muted uppercase">
          {p.founders.eyebrow}
        </p>
        <h2 class="mt-4 max-w-3xl text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-on-ink lg:text-[2rem]">
          {
            rellenar(p.founders.title, {
              n: String(negocio.fundadores.cupo),
              months: String(negocio.fundadores.meses),
            })
          }
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-on-ink-muted">{p.founders.body}</p>
        <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-on-ink-muted">
          {rellenar(p.founders.note, { months: String(negocio.fundadores.meses) })}
        </p>
      </div>
      <Button href={contacto('fundador', lang)} variant="onInk" size="lg">{p.founders.cta}</Button>
    </div>
  </Section>

  <!-- ============================================================= SERVICIOS -->
  <!-- Otro fondo y otro encabezado a propósito: lo que sigue no es parte de
       ningún plan. -->
  <Section tone="panel" id="servicios">
    <div class="reveal">
      <SectionHeader eyebrow={p.services.eyebrow} title={p.services.title} intro={p.services.intro} />
    </div>

    <!-- Resumen del catálogo: nombre, cómo se paga y cuánto. El detalle de cada
         servicio —para quién es, qué incluye, sus límites— vive en Servicios,
         y no se repite aquí. -->
    <div
      class="reveal mt-10 overflow-x-auto border border-line"
      data-reveal-delay="80"
      role="region"
      tabindex="0"
      aria-label={p.services.caption}
    >
      <table class="w-full min-w-[40rem] border-collapse bg-panel">
        <caption class="sr-only">{p.services.caption}</caption>
        <thead>
          <tr class="border-b-2 border-ink">
            <th scope="col" class={encabezado}>{p.services.cols.service}</th>
            <th scope="col" class={encabezado}>{p.services.cols.modality}</th>
            {mostrar && <th scope="col" class={encabezado}>{p.services.cols.price}</th>}
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            ORDEN_SERVICIOS.map((id) => (
              <tr>
                <th scope="row" class={`${celda} text-left font-semibold`}>
                  <a
                    href={`${path('services', lang)}#${id}`}
                    class="underline decoration-line-strong underline-offset-4 hover:decoration-ink"
                  >
                    {sv.items[id].name}
                  </a>
                </th>
                <td class={`${celda} text-muted`}>{sv.items[id].modality}</td>
                {mostrar && (
                  <td class={`${celda} tnum`}>
                    {preciosSv[id].map((pr) => (
                      <span class="block whitespace-nowrap">
                        <span class="font-semibold">{pr.importe}</span>{' '}
                        <span class="text-muted">{pr.unidad}</span>
                      </span>
                    ))}
                  </td>
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="reveal mt-5 max-w-2xl border-l-2 border-brand pl-5 text-[0.9375rem] leading-relaxed text-ink">
      {p.diagnostics.credit}
    </p>
    <div class="reveal mt-8">
      <Button href={path('services', lang)} variant="secondary">{p.services.cta}</Button>
    </div>
  </Section>

  <!-- ============================================================= PREGUNTAS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={p.faq.title} />
    </div>
    <FaqList items={preguntas} class="reveal mt-10" />
  </Section>

  <!-- ================================================================= CIERRE -->
  <Section tone="ground" size="compact">
    {mostrar && <p class="reveal text-sm font-medium text-muted">{p.tax}</p>}
    <div class="reveal mt-8 max-w-3xl border-t border-line pt-10">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {p.closing.title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">{p.closing.body}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={agenda(lang)} size="lg" data-cta="agenda">{p.closing.primary}</Button>
        <Button href={path('contact', lang)} variant="secondary" size="lg">
          {p.closing.secondary}
        </Button>
      </div>
    </div>
  </Section>
</Base>
