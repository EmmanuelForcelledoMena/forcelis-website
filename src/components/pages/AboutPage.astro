---
/**
 * Nosotros (`/es/nosotros/`) y About (`/en/about/`).
 *
 * Una plantilla, dos textos: el español le habla a un dueño de negocio en
 * México y el inglés a una empresa extranjera, pero las dos páginas tienen la
 * misma forma —quién soy, cómo trabajo, qué no hago—. Los diccionarios tienen
 * la misma estructura y cada idioma lleva el estilo de su línea: claro en
 * español, con secciones oscuras en inglés.
 *
 * En una consultoría de una persona se contrata a alguien, no a una marca: por
 * eso el titular es el nombre.
 *
 * La foto se resuelve en la build desde `src/assets/equipo/emmanuel.*`. Sin
 * archivo, la columna no se dibuja: la página se ve completa, sin hueco ni
 * silueta genérica. El enlace a LinkedIn sale solo si `negocio.url_linkedin`
 * tiene valor.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import Cta from '../Cta.astro';
import { negocio } from '../../config/negocio';
import { agenda } from '../../config/enlaces';
import { path, type Lang } from '../../i18n/routes';
import { es, en } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = lang === 'es' ? es('about') : en('about');
const dark = lang === 'en';
const agendaHref = agenda(lang);

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/equipo/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const retrato = Object.entries(fotos).find(([file]) => /\/emmanuel\.(jpe?g|png|webp)$/.test(file))?.[1]
  .default;

const linkedin = negocio.url_linkedin;
---

<Base lang={lang} pageKey="about" title={a.meta.title} description={a.meta.description}>
  <PageHero tone={dark ? 'dark' : 'light'} eyebrow={a.hero.eyebrow} title={a.hero.title} intro={a.hero.subtitle} />

  <!-- ================================================================== BIO -->
  <Section tone="ground">
    <div class:list={['grid gap-12', retrato ? 'lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16' : '']}>
      {
        retrato && (
          <div class="reveal">
            <Image
              src={retrato}
              alt={a.bio.photoAlt}
              width={700}
              height={875}
              format="webp"
              loading="eager"
              class="aspect-[4/5] w-full max-w-sm rounded-card border border-line object-cover"
            />
          </div>
        )
      }

      <div class="reveal grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,16rem)] lg:gap-16" data-reveal-delay="80">
        <div>
          <h2 class="text-2xl font-medium tracking-[-0.01em] text-ink lg:text-3xl">{a.bio.title}</h2>
          <div class="mt-6 max-w-[68ch] space-y-5">
            {a.bio.paragraphs.map((p) => <p class="text-lg leading-relaxed text-muted">{p}</p>)}
          </div>
        </div>
        <aside class="self-start rounded-card border border-line bg-panel p-6">
          <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">{a.bio.languagesLabel}</p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink">{a.bio.languages}</p>
          {
            linkedin && (
              <a
                href={linkedin}
                rel="noopener"
                target="_blank"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
              >
                {a.linkedin}
              </a>
            )
          }
        </aside>
      </div>
    </div>
  </Section>

  <!-- ============================================================= PRINCIPIOS -->
  <Section tone={dark ? 'ink' : 'panel'}>
    <div class="reveal">
      <SectionHeader eyebrow={a.principles.eyebrow} title={a.principles.title} tone={dark ? 'light' : 'ink'} />
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        a.principles.items.map((item, i) => (
          <li
            class:list={[
              'reveal rounded-card border p-7',
              dark ? 'border-line-ink bg-ink-soft' : 'border-line bg-panel',
            ]}
            data-reveal-delay={i * 80}
          >
            <span class:list={['tnum text-sm font-semibold', dark ? 'text-on-ink-muted' : 'text-brand-text']}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class:list={['mt-4 text-xl leading-snug font-medium', dark ? 'text-on-ink' : 'text-ink']}>{item.title}</h3>
            <p class:list={['mt-3 text-[0.9375rem] leading-relaxed', dark ? 'text-on-ink-muted' : 'text-muted']}>
              {item.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ================================================================ QUÉ NO -->
  <Section tone="ground" size="compact">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="text-2xl font-medium tracking-[-0.01em] text-ink lg:text-3xl">{a.notUs.title}</h2>
      <ul class="divide-y divide-line border-t border-b border-line">
        {
          a.notUs.items.map((item) => (
            <li class="flex items-start gap-5 py-5">
              <span aria-hidden="true" class="mt-3 block h-[2px] w-4 shrink-0 bg-brand" />
              <p class="text-base leading-relaxed text-ink lg:text-lg">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Cta
    tone={dark ? 'dark' : 'light'}
    title={a.closing.title}
    body={a.closing.body}
    primary={{ href: agendaHref, label: a.closing.primary }}
    secondary={{ href: path('services', lang), label: a.closing.secondary }}
  />
</Base>
