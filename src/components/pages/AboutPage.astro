---
/**
 * Nosotros. Rediseño v2.
 *
 * Cambios respecto a la versión anterior:
 *
 *  1. PRINCIPIOS — de cuatro tarjetas con borde a filas regladas numeradas. El
 *     texto de cada principio se leía a 44 caracteres de ancho dentro de su
 *     caja; ahora se lee a lo largo de la página.
 *  2. ESTRUCTURA — de tres celdas sobre tinta a tres columnas de prosa. Son
 *     tres descripciones, no tres productos que se comparan.
 *
 * Origen, «lo que combina» y «dónde está hoy» se conservan tal cual: ya eran
 * prosa reglada y no tenían el problema.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import RuledRows from '../RuledRows.astro';
import ProseColumns from '../ProseColumns.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang, 'about');
---

<Base lang={lang} pageKey="about" title={a.meta.title} description={a.meta.description}>
  <PageHero
    photoKey="about"
    eyebrow={a.hero.eyebrow}
    title={a.hero.title}
    intro={a.hero.subtitle}
  />

  <!-- ================================================================= ORIGEN -->
  <Section tone="ground">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <h2 class="reveal text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {a.origin.title}
      </h2>
      <div class="reveal space-y-6" data-reveal-delay="80">
        {a.origin.body.map((paragraph) => <p class="text-lg leading-relaxed text-muted">{paragraph}</p>)}
      </div>
    </div>
  </Section>

  <!-- ============================================================== COMBINA -->
  <Section tone="panel" size="compact">
    <div class="reveal">
      <SectionHeader title={a.combine.title} />
    </div>
    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        a.combine.items.map((item, i) => (
          <div class="reveal" data-reveal-delay={i * 70}>
            <span aria-hidden="true" class="block h-[2px] w-10 bg-brand" />
            <h3 class="mt-5 text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ============================================================ PRINCIPIOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={a.principles.title} intro={a.principles.intro} />
    </div>

    <RuledRows
      items={a.principles.items.map((item) => ({ term: item.title, body: item.body }))}
      numbered
      termWidth="wide"
      class="mt-14"
    />
  </Section>

  <!-- ============================================================= ESTRUCTURA -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader title={a.structure.title} intro={a.structure.intro} tone="light" />
    </div>

    <ProseColumns
      items={a.structure.lines.map((line) => ({
        eyebrow: line.sub,
        title: line.name,
        body: line.body,
      }))}
      tone="light"
      class="mt-14"
    />
  </Section>

  <!-- ================================================================= ETAPA -->
  <Section tone="panel" size="compact">
    <div class="reveal grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
          {a.stage.title}
        </h2>
        <p class="mt-5 text-sm font-medium text-muted">{a.stage.location}</p>
      </div>
      <p class="text-lg leading-relaxed text-muted">{a.stage.body}</p>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={a.closing.title}
    body={a.closing.body}
    primaryLabel={a.closing.primary}
    secondaryLabel={a.closing.secondary}
  />
</Base>
