---
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang, 'about');
---

<Base lang={lang} pageKey="about" title={a.meta.title} description={a.meta.description}>
  <Section tone="ground" size="compact" class="border-b border-line">
    <div class="reveal">
      <SectionHeader as="h1" eyebrow={a.hero.eyebrow} title={a.hero.title} intro={a.hero.subtitle} />
    </div>
  </Section>

  <!-- ================================================================= ORIGEN -->
  <Section tone="ground">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <h2 class="reveal text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {a.origin.title}
      </h2>
      <div class="reveal space-y-6" data-reveal-delay="80">
        {a.origin.body.map((paragraph) => <p class="text-lg leading-relaxed text-muted">{paragraph}</p>)}
      </div>
    </div>
  </Section>

  <!-- ============================================================== COMBINA -->
  <Section tone="panel" size="compact">
    <div class="reveal">
      <SectionHeader title={a.combine.title} />
    </div>
    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        a.combine.items.map((item, i) => (
          <div class="reveal" data-reveal-delay={i * 70}>
            <span aria-hidden="true" class="block h-[2px] w-10 bg-brand" />
            <h3 class="mt-5 text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ============================================================ PRINCIPIOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={a.principles.title} intro={a.principles.intro} />
    </div>

    <div class="mt-14 grid gap-px border border-line bg-line lg:grid-cols-2">
      {
        a.principles.items.map((item, i) => (
          <article class="reveal bg-ground p-8 lg:p-10" data-reveal-delay={(i % 2) * 80}>
            <span class="tnum text-xs font-semibold text-brand-text">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-xl leading-snug font-semibold text-ink">{item.title}</h3>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ============================================================= ESTRUCTURA -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader title={a.structure.title} intro={a.structure.intro} tone="light" />
    </div>

    <div class="mt-14 grid gap-px border border-line-ink bg-line-ink lg:grid-cols-3">
      {
        a.structure.lines.map((line, i) => (
          <article class="reveal bg-ink p-8 lg:p-10" data-reveal-delay={i * 80}>
            <h3 class="text-lg font-semibold tracking-[0.02em] text-on-ink">{line.name}</h3>
            <p class="mt-1.5 text-[0.6875rem] font-semibold tracking-[0.14em] text-brand uppercase">
              {line.sub}
            </p>
            <p class="mt-5 text-[0.9375rem] leading-relaxed text-on-ink-muted">{line.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ================================================================= ETAPA -->
  <Section tone="panel" size="compact">
    <div class="reveal grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
          {a.stage.title}
        </h2>
        <p class="mt-5 text-sm font-medium text-muted">{a.stage.location}</p>
      </div>
      <p class="text-lg leading-relaxed text-muted">{a.stage.body}</p>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={a.closing.title}
    body={a.closing.body}
    primaryLabel={a.closing.primary}
    secondaryLabel={a.closing.secondary}
  />
</Base>
