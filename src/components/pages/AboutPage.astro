---
/**
 * Nosotros.
 *
 * En una consultoría de una persona, esta página vende tanto como la de
 * servicios: se contrata a alguien, no a una marca. Por eso el titular es el
 * nombre y la foto va arriba, junto a la biografía, y no de adorno al final.
 *
 * Las tres reglas de trabajo están escritas desde lo que cuestan —«si no estás
 * listo, te lo digo»— y no como valores. Un valor lo escribe cualquiera; una
 * regla que te hace perder una venta es una afirmación comprobable.
 *
 * La foto se resuelve en la build desde `src/assets/equipo/emmanuel.*`. Sin
 * archivo, la columna no se dibuja: la página se ve completa, nunca con un
 * hueco ni con una silueta genérica.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import { negocio } from '../../config/negocio';
import { agenda } from '../../config/enlaces';
import { path, type Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang, 'about');
const agendaHref = agenda(lang);

const fotos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/equipo/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const retrato = Object.entries(fotos).find(([file]) =>
  /\/emmanuel\.(jpe?g|png|webp)$/.test(file),
)?.[1].default;
---

<Base lang={lang} pageKey="about" title={a.meta.title} description={a.meta.description}>
  <PageHero
    photoKey="about"
    eyebrow={a.hero.eyebrow}
    title={a.hero.title}
    intro={a.hero.subtitle}
  />

  <!-- ================================================================== BIO -->
  <Section tone="ground">
    <div
      class:list={[
        'grid gap-12',
        retrato ? 'lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16' : '',
      ]}
    >
      {
        retrato && (
          <div class="reveal">
            <Image
              src={retrato}
              alt="Emmanuel Forcelledo, fundador de Forcelis"
              width={700}
              height={875}
              format="webp"
              loading="eager"
              class="w-full max-w-sm border border-line object-cover"
            />
            {negocio.url_linkedin && (
              <a
                href={negocio.url_linkedin}
                rel="noopener"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-text underline underline-offset-4"
              >
                {a.linkedin}
              </a>
            )}
          </div>
        )
      }

      <div class="reveal" data-reveal-delay="80">
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
          {a.bio.title}
        </h2>
        <div class="mt-6 max-w-[68ch] space-y-5">
          {a.bio.paragraphs.map((p) => <p class="text-lg leading-relaxed text-muted">{p}</p>)}
        </div>
        {
          !retrato && negocio.url_linkedin && (
            <a
              href={negocio.url_linkedin}
              rel="noopener"
              class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-brand-text underline underline-offset-4"
            >
              {a.linkedin}
            </a>
          )
        }
      </div>
    </div>
  </Section>

  <!-- ============================================================= PRINCIPIOS -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader eyebrow={a.principles.eyebrow} title={a.principles.title} tone="light" />
    </div>
    <ol class="mt-14 grid gap-10 border-t border-line-ink pt-10 sm:grid-cols-3 sm:gap-8">
      {
        a.principles.items.map((item, i) => (
          <li class="reveal" data-reveal-delay={i * 80}>
            <span class="tnum text-xs font-semibold text-on-ink-muted">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-xl leading-snug font-semibold text-on-ink">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-on-ink-muted">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ================================================================ QUÉ NO -->
  <Section tone="panel" size="compact">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {a.notUs.title}
      </h2>
      <ul class="divide-y divide-line border-t border-b border-line">
        {
          a.notUs.items.map((item) => (
            <li class="flex items-start gap-5 py-5">
              <span aria-hidden="true" class="mt-3 block h-[2px] w-4 shrink-0 bg-brand" />
              <p class="text-base leading-relaxed text-ink lg:text-lg">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- ================================================================ CIERRE -->
  <Section tone="ground">
    <div class="reveal max-w-3xl">
      <h2 class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] text-ink sm:text-[2.75rem] lg:text-5xl">
        {a.closing.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">{a.closing.body}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href={agendaHref} size="lg" data-cta="agenda">{a.closing.primary}</Button>
        <Button href={path('services', lang)} variant="secondary" size="lg">
          {a.closing.secondary}
        </Button>
      </div>
    </div>
  </Section>
</Base>
