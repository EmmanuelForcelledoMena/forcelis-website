---
/**
 * Estudio de Expansión: la puerta de entrada de quien ya piensa en crecer.
 *
 * El orden responde a cómo decide un dueño de negocio:
 *
 *   1. Las cuatro preguntas que se hace, tal cual las haría él.
 *   2. Qué hay que entregar (y qué nunca se pide) y qué recibe, con duración
 *      y precio — el dato que busca —.
 *   3. Los tres veredictos posibles, incluido «todavía no», cada uno con su
 *      siguiente paso.
 *   4. Una vista previa del reporte, marcada «Datos ilustrativos».
 *
 * El importe sale de `negocio.ts`; aquí no se escribe ninguna cifra.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import Checklist from '../Checklist.astro';
import ScorePanel from '../ScorePanel.astro';
import Cta from '../Cta.astro';
import { serviciosResueltos } from '../../i18n/servicios';
import { agenda, contratarServicio } from '../../config/enlaces';
import { path } from '../../i18n/routes';
import { es, common } from '../../i18n';

const lang = 'es';
const e = es('expansion');
const s = es('services');
const c = common(lang);

const servicio = serviciosResueltos().find((x) => x.id === 'expansion')!;
const agendaHref = agenda(lang);
const servicios = path('services', lang);
---

<Base lang={lang} pageKey="expansion" title={e.meta.title} description={e.meta.description}>
  <PageHero eyebrow={e.hero.eyebrow} title={e.hero.title} intro={e.hero.subtitle}>
    <Fragment slot="actions">
      <Button href={agendaHref} size="lg">{e.hero.cta}</Button>
      <Button href={contratarServicio('expansion', lang)} variant="secondary" size="lg">{s.labels.write}</Button>
    </Fragment>
  </PageHero>

  <!-- ============================================================= PREGUNTAS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={e.questions.eyebrow} title={e.questions.title} />
    </div>
    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        e.questions.items.map((pregunta, i) => (
          <li class="reveal flex flex-col rounded-card border border-line bg-panel p-6" data-reveal-delay={i * 60}>
            <span class="tnum text-sm font-semibold text-brand-text">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-4 text-xl leading-snug font-medium text-ink">{pregunta}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ===================================================== ENTRADA Y SALIDA -->
  <Section tone="panel">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <SectionHeader eyebrow={e.inputs.eyebrow} title={e.inputs.title} />
        <Checklist
          class="mt-8"
          items={e.inputs.items.map((item) => ({
            text: item.text,
            tag: item.required ? c.labels.required : c.labels.optional,
            tagTone: (item.required ? 'brand' : 'ink') as 'brand' | 'ink',
          }))}
        />
        <p class="mt-6 flex items-start gap-3 rounded-control border border-line bg-panel px-4 py-3 text-[0.9375rem] font-medium text-ink">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="mt-0.5 shrink-0 text-brand">
            <path d="M9 1.5 3 4v4.5c0 3.6 2.6 6.9 6 8 3.4-1.1 6-4.4 6-8V4L9 1.5Z" stroke="currentColor" stroke-width="1.5" />
            <path d="m6.5 9 1.8 1.8L11.8 7" stroke="currentColor" stroke-width="1.5" />
          </svg>
          {e.inputs.never}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-muted">{e.inputs.note}</p>
      </div>

      <div class="reveal" data-reveal-delay="80">
        <SectionHeader eyebrow={e.deliverable.eyebrow} title={e.deliverable.title} />
        <Checklist class="mt-8" items={e.deliverable.items.map((text) => ({ text }))} />
        <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line">
          <div class="bg-panel p-5">
            <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{e.deliverable.duration}</dt>
            <dd class="mt-2 text-lg font-semibold text-ink">{servicio.duracion}</dd>
          </div>
          <div class="bg-panel p-5">
            <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{e.deliverable.price}</dt>
            <dd class="tnum mt-2 text-lg font-semibold text-ink">{servicio.precio}</dd>
            <dd class="mt-0.5 text-xs text-muted">{e.deliverable.tax}</dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <!-- ============================================================ VEREDICTOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={e.verdicts.eyebrow} title={e.verdicts.title} intro={e.verdicts.intro} />
    </div>
    <ol class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        e.verdicts.items.map((v, i) => (
          <li class="reveal flex flex-col rounded-card border border-line bg-panel p-7" data-reveal-delay={i * 80}>
            <span aria-hidden="true" class:list={['block h-1 w-10 rounded-full', i === 2 ? 'bg-arena' : 'bg-brand']} />
            <h3 class="mt-5 text-xl leading-snug font-medium text-ink">{v.name}</h3>
            <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{v.body}</p>
            <div class="mt-6 border-t border-line pt-4">
              <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-brand-text uppercase">{e.verdicts.next}</p>
              {v.href ? (
                <a
                  href={`${servicios}#${v.href}`}
                  class="mt-1.5 inline-block text-[0.9375rem] font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
                >
                  {v.next}
                </a>
              ) : (
                <p class="mt-1.5 text-[0.9375rem] font-medium text-ink">{v.next}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ========================================================== VISTA PREVIA -->
  <Section tone="panel">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-center lg:gap-16">
      <div class="reveal">
        <SectionHeader eyebrow={e.preview.eyebrow} title={e.preview.title} intro={e.preview.intro} />
      </div>
      <ScorePanel
        class="reveal"
        title={e.preview.panelTitle}
        items={e.preview.items}
        illustrativeLabel={c.labels.illustrative}
        outOfLabel={c.labels.scoreOutOf}
        overallLabel={c.labels.overallScore}
        overallNote={c.labels.overallNote}
        footnote={e.preview.footnote}
      />
    </div>
  </Section>

  <Cta
    title={e.closing.title}
    body={e.closing.body}
    primary={{ href: agendaHref, label: e.closing.primary }}
    secondary={{ href: servicios, label: e.closing.secondary }}
  />
</Base>
