---
/**
 * Soluciones. Rediseño v3.
 *
 * Responde «¿qué problemas de negocio resuelve Forcelis?». Dos niveles:
 *
 *   1. ÍNDICE — cuatro áreas de resultado (tres etiquetas cada una) y dos de
 *      apoyo. Son las mismas tarjetas de la portada, para que quien llega
 *      desde allí reconozca dónde está.
 *   2. DETALLE — seis bloques plegados, uno por área, con la misma anatomía:
 *      qué es · qué analizamos · qué recibes · resultado. Antes los seis
 *      bloques iban desplegados uno tras otro y la página medía cinco
 *      pantallas; ahora se abre el que interesa. El ancla `#financial` abre
 *      su bloque al aterrizar (script en `Base.astro`).
 *
 * El texto de cada bloque es el de la versión anterior: `lead` pasa a «qué
 * es», `services` a «qué analizamos» y `outcome` a «qué recibes»; «resultado»
 * es una frase nueva que resume ese último párrafo.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import SolutionCard from '../SolutionCard.astro';
import Disclosure from '../Disclosure.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang, 'solutions');
const c = common(lang);

const iconFor: Record<
  string,
  'financial' | 'operational' | 'supply' | 'accounting' | 'advisory' | 'managed'
> = {
  financial: 'financial',
  operational: 'operational',
  supply: 'supply',
  accounting: 'accounting',
  advisory: 'advisory',
  managed: 'managed',
};
---

<Base lang={lang} pageKey="solutions" title={s.meta.title} description={s.meta.description}>
  <PageHero
    photoKey="solutions"
    eyebrow={s.hero.eyebrow}
    title={s.hero.title}
    intro={s.hero.subtitle}
  />

  <!-- ================================================================ ÍNDICE -->
  <Section tone="ground" size="compact">
    <!-- Encabezado solo para el árbol: las tarjetas llevan h3 y sin esto la
         página saltaría del h1 del hero al h3. -->
    <h2 class="sr-only">{s.hero.eyebrow}</h2>
    <div class="flex flex-col gap-px border border-line bg-line">
      <div class="grid gap-px sm:grid-cols-2 lg:grid-cols-4">
        {
          s.areas.map((area, i) => (
            <div class="reveal flex" data-reveal-delay={(i % 4) * 70}>
              <SolutionCard
                icon={iconFor[area.key]}
                title={area.title}
                tags={area.tags}
                href={`#${area.key}`}
                class="flex-1"
              >
                <Fragment slot="more">{c.labels.details}</Fragment>
              </SolutionCard>
            </div>
          ))
        }
      </div>
      <div class="grid gap-px sm:grid-cols-2">
        {
          s.support.map((item, i) => (
            <div class="reveal flex" data-reveal-delay={i * 70}>
              <SolutionCard
                variant="support"
                title={item.title}
                body={item.body}
                href={`#${item.key}`}
                class="flex-1"
              >
                <Fragment slot="more">{c.labels.details}</Fragment>
              </SolutionCard>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- =============================================================== DETALLE -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={s.detailTitle} intro={s.detailIntro} />
    </div>

    <div class="reveal mt-12 border-b border-line" data-reveal-delay="80">
      {
        s.groups.map((group) => (
          <Disclosure id={group.key} summary={group.title} meta={group.num}>
            <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-12">
              <div>
                <p class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {s.labels.whatItIs}
                </p>
                <p class="mt-3 text-lg leading-snug font-semibold tracking-[-0.01em] text-ink">
                  {group.whatItIs}
                </p>
                <div class="mt-8 border-l-2 border-brand pl-4">
                  <p class="text-[0.625rem] font-semibold tracking-[0.14em] text-brand-text uppercase">
                    {s.labels.outcome}
                  </p>
                  <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink">{group.outcome}</p>
                </div>
              </div>

              <div>
                <p class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {s.labels.analyze}
                </p>
                <ul class="mt-3 grid gap-x-6 sm:grid-cols-2 lg:grid-cols-1">
                  {group.analyze.map((service) => (
                    <li class="flex items-start gap-3 border-b border-line py-2.5 text-[0.9375rem] text-ink">
                      <span aria-hidden="true" class="mt-2.5 block h-1 w-1 shrink-0 bg-brand" />
                      {service}
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <p class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {s.labels.youGet}
                </p>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{group.youGet}</p>
              </div>
            </div>
          </Disclosure>
        ))
      }
    </div>
  </Section>

  <Section tone="ground" size="compact">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {s.note.title}
      </h2>
      <p class="max-w-3xl text-lg leading-relaxed text-muted">{s.note.body}</p>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={s.closing.title}
    body={s.closing.body}
    primaryLabel={s.closing.primary}
    secondaryLabel={s.closing.secondary}
  />
</Base>
