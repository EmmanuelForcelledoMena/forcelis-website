---
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PlatformArchitecture from '../PlatformArchitecture.astro';
import Icon from '../Icon.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang, 'platform');
---

<Base lang={lang} pageKey="platform" title={p.meta.title} description={p.meta.description}>
  <Section tone="ground" size="compact" class="border-b border-line">
    <div class="reveal">
      <SectionHeader as="h1" eyebrow={p.hero.eyebrow} title={p.hero.title} intro={p.hero.subtitle} />
    </div>
  </Section>

  <!-- ========================================================= ARQUITECTURA -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={p.architecture.title} intro={p.architecture.intro} align="center" />
    </div>
    <div class="reveal mt-14" data-reveal-delay="80">
      <PlatformArchitecture
        sourcesLabel={p.architecture.sourcesLabel}
        sources={p.architecture.sources}
        platformLabel={p.architecture.platformLabel}
        platformSub={p.architecture.platformSub}
        layersLabel={p.architecture.layersLabel}
        layers={p.architecture.layers}
        outcomeLabel={p.architecture.outcomeLabel}
        outcomeSub={p.architecture.outcomeSub}
        diagramAlt={p.architecture.diagramAlt}
      />
    </div>
  </Section>

  <!-- ============================================================ PRINCIPIOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={p.principles.title} intro={p.principles.intro} />
    </div>

    <div class="mt-14 grid gap-px border border-line bg-line lg:grid-cols-2">
      {
        p.principles.items.map((item, i) => (
          <article class="reveal bg-ground p-8 lg:p-10" data-reveal-delay={(i % 2) * 80}>
            <span aria-hidden="true" class="block h-[2px] w-10 bg-brand" />
            <h3 class="mt-6 text-xl leading-snug font-semibold text-ink">{item.title}</h3>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ================================================================ ESTADO -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={p.status.title} intro={p.status.intro} />
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-2 lg:gap-12">
      <div class="reveal">
        <h3
          class="flex items-center gap-3 border-b-2 border-ink pb-4 text-[0.6875rem] font-semibold tracking-[0.16em] text-ink uppercase"
        >
          <Icon name="check" class="h-4 w-4 text-brand-text" />
          {p.status.todayLabel}
        </h3>
        <ul class="mt-2 divide-y divide-line">
          {
            p.status.today.map((item) => (
              <li class="py-5">
                <p class="text-base font-semibold text-ink">{item.title}</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal" data-reveal-delay="100">
        <h3
          class="flex items-center gap-3 border-b-2 border-line-strong pb-4 text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase"
        >
          <span aria-hidden="true" class="block h-[2px] w-4 bg-line-strong"></span>
          {p.status.futureLabel}
        </h3>
        <ul class="mt-2 divide-y divide-line">
          {
            p.status.future.map((item) => (
              <li class="py-5">
                <p class="text-base font-semibold text-muted">{item.title}</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============================================================= FRONTERAS -->
  <Section tone="ink" size="compact">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="reveal text-2xl font-semibold tracking-[-0.02em] text-on-ink lg:text-3xl">
        {p.boundaries.title}
      </h2>
      <ul class="reveal space-y-4" data-reveal-delay="80">
        {
          p.boundaries.items.map((item) => (
            <li class="flex items-start gap-4 border-b border-line-ink pb-4 text-[0.9375rem] text-on-ink-muted">
              <span aria-hidden="true" class="mt-2.5 block h-1 w-4 shrink-0 bg-brand" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={p.closing.title}
    body={p.closing.body}
    primaryLabel={p.closing.primary}
    secondaryLabel={p.closing.secondary}
  />
</Base>
