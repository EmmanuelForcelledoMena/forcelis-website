---
/**
 * Plataforma. Rediseño v2.
 *
 * Cambios respecto a la versión anterior:
 *
 *  1. SE ELIMINA la columna «En desarrollo» (decisión del cliente). La sección
 *     de estado pasa a ser solo lo disponible hoy, a ancho completo en dos
 *     columnas — que además es como debe verse: la lista ya no está compitiendo
 *     con una segunda columna de cosas que no existen.
 *     El texto sigue en el diccionario (`status.future`, `status.futureLabel`):
 *     no se borra de i18n, solo deja de renderizarse. Si se quiere recuperar,
 *     es descomentar; no hay que reescribir el copy.
 *  2. PRINCIPIOS — de cuatro tarjetas con borde a filas regladas numeradas.
 *  3. FRONTERAS — de lista con viñetas a filas regladas con guion de marca, y a
 *     tamaño de lectura: son las cuatro frases más importantes de la página
 *     para un comprador técnico y estaban puestas como pie de nota.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import PlatformArchitecture from '../PlatformArchitecture.astro';
import RuledRows from '../RuledRows.astro';
import Icon from '../Icon.astro';
import Cta from '../Cta.astro';
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang, 'platform');
---

<Base lang={lang} pageKey="platform" title={p.meta.title} description={p.meta.description}>
  <PageHero
    photoKey="platform"
    eyebrow={p.hero.eyebrow}
    title={p.hero.title}
    intro={p.hero.subtitle}
  />

  <!-- ========================================================= ARQUITECTURA -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={p.architecture.title} intro={p.architecture.intro} align="center" />
    </div>
    <div class="reveal mt-14" data-reveal-delay="80">
      <PlatformArchitecture
        sourcesLabel={p.architecture.sourcesLabel}
        sources={p.architecture.sources}
        platformLabel={p.architecture.platformLabel}
        platformSub={p.architecture.platformSub}
        layersLabel={p.architecture.layersLabel}
        layers={p.architecture.layers}
        outcomeLabel={p.architecture.outcomeLabel}
        outcomeSub={p.architecture.outcomeSub}
        diagramAlt={p.architecture.diagramAlt}
      />
    </div>
  </Section>

  <!-- ============================================================ PRINCIPIOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={p.principles.title} intro={p.principles.intro} />
    </div>

    <RuledRows
      items={p.principles.items.map((item) => ({ term: item.title, body: item.body }))}
      numbered
      termWidth="wide"
      class="mt-14"
    />
  </Section>

  <!-- ================================================================ ESTADO -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={p.status.title} intro={p.status.intro} />
    </div>

    <div class="reveal mt-14">
      <h3
        class="flex items-center gap-3 border-b-2 border-ink pb-4 text-[0.6875rem] font-semibold tracking-[0.16em] text-ink uppercase"
      >
        <Icon name="check" class="h-4 w-4 text-brand-text" />
        {p.status.todayLabel}
      </h3>

      <!-- Dos columnas de lista sobre el mismo bloque: la sección ocupa el
           ancho que antes se repartía con «En desarrollo», sin que ninguna
           entrada quede huérfana al final de una columna. -->
      <ul class="mt-2 grid gap-x-16 sm:grid-cols-2">
        {
          p.status.today.map((item) => (
            <li class="border-b border-line py-5">
              <p class="text-base font-semibold text-ink">{item.title}</p>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!--
      Columna «En desarrollo» retirada a petición del cliente. El copy sigue
      disponible en `platform.status.future` / `status.futureLabel`.

      <div class="reveal mt-14" data-reveal-delay="100">
        <h3 class="flex items-center gap-3 border-b-2 border-line-strong pb-4 text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase">
          <span aria-hidden="true" class="block h-[2px] w-4 bg-line-strong"></span>
          {p.status.futureLabel}
        </h3>
        <ul class="mt-2 grid gap-x-16 sm:grid-cols-2">
          {p.status.future.map((item) => (
            <li class="border-b border-line py-5">
              <p class="text-base font-semibold text-muted">{item.title}</p>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    -->
  </Section>

  <!-- ============================================================= FRONTERAS -->
  <Section tone="ink" size="compact">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="reveal text-2xl font-semibold tracking-[-0.02em] text-on-ink lg:text-3xl">
        {p.boundaries.title}
      </h2>
      <ul class="reveal divide-y divide-line-ink border-t border-b border-line-ink" data-reveal-delay="80">
        {
          p.boundaries.items.map((item) => (
            <li class="flex items-start gap-5 py-5">
              <span aria-hidden="true" class="mt-3 block h-[2px] w-4 shrink-0 bg-brand" />
              <p class="text-base leading-relaxed font-medium text-on-ink lg:text-lg">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={p.closing.title}
    body={p.closing.body}
    primaryLabel={p.closing.primary}
    secondaryLabel={p.closing.secondary}
  />
</Base>
