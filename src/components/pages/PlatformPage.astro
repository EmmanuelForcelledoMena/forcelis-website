---
/**
 * Plataforma. Rediseño v3.
 *
 * Responde «¿cómo funciona la tecnología?» en tres niveles de profundidad, y
 * el visitante elige hasta cuál baja:
 *
 *   1. DIAGRAMA — lo que importas → Forcelis (importar · normalizar · analizar ·
 *      explicar) → decisiones. Es el visual principal de la página.
 *   2. CUATRO PRINCIPIOS — una palabra y una frase cada uno (determinista,
 *      privada, segura, honesta). El párrafo largo de cada principio —el
 *      «enfoque técnico», con HHI, row-level security y e.firma— sigue en la
 *      página, plegado: nada se borra, baja de nivel.
 *   3. QUÉ FUNCIONA HOY — cinco pasos de una línea, el tablero del producto
 *      como prueba de que hay software, y las nueve capacidades plegadas bajo
 *      «ver capacidades técnicas».
 *
 * La columna «En desarrollo» sigue retirada (decisión del cliente); el copy
 * está en `status.future` por si se recupera. Las fronteras («qué no es la
 * plataforma») se conservan: son las cuatro frases que más pesan para un
 * comprador técnico.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import PageHero from '../PageHero.astro';
import PlatformArchitecture from '../PlatformArchitecture.astro';
import DashboardPreview from '../DashboardPreview.astro';
import Disclosure from '../Disclosure.astro';
import Tag from '../Tag.astro';
import Button from '../Button.astro';
import RuledRows from '../RuledRows.astro';
import { agenda } from '../../config/enlaces';
import { path, type Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';
import { negocio } from '../../config/negocio';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = t(lang, 'platform');
const c = common(lang);
---

<Base lang={lang} pageKey="platform" title={p.meta.title} description={p.meta.description}>
  <PageHero
    photoKey="platform"
    eyebrow={p.hero.eyebrow}
    title={p.hero.title}
    intro={p.hero.subtitle}
  />

  <!-- ========================================================= ARQUITECTURA -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={p.architecture.title} intro={p.architecture.intro} align="center" />
    </div>
    <div class="reveal mt-14" data-reveal-delay="80">
      <PlatformArchitecture
        sourcesLabel={p.architecture.sourcesLabel}
        sources={p.architecture.sources}
        platformLabel={p.architecture.platformLabel}
        steps={p.architecture.steps}
        outcomeLabel={p.architecture.outcomeLabel}
        outcomeSub={p.architecture.outcomeSub}
        diagramAlt={p.architecture.diagramAlt}
      />
    </div>
  </Section>

  <!-- ============================================================ PRINCIPIOS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={p.principles.title} intro={p.principles.intro} />
    </div>

    <ol class="mt-14 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        p.principles.items.map((item, i) => (
          <li class="reveal flex flex-col bg-panel p-7" data-reveal-delay={i * 70}>
            <span class="tnum text-xs font-semibold text-brand-text">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-sm font-semibold tracking-[0.14em] text-ink uppercase">{item.label}</h3>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{item.title}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-10 border-b border-line" data-reveal-delay="100">
      <Disclosure summary={p.principles.technicalLabel} meta={p.principles.technicalMeta}>
        <RuledRows
          items={p.principles.items.map((item) => ({ term: item.title, body: item.body }))}
          numbered
          termWidth="wide"
        />
      </Disclosure>
    </div>
  </Section>

  <!-- ================================================================ ESTADO -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={p.status.title} intro={p.status.intro} />
    </div>

    <ol class="mt-14 grid gap-x-8 gap-y-10 border-t-2 border-ink pt-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        p.status.steps.map((step, i) => (
          <li class="reveal" data-reveal-delay={i * 60}>
            <span class="tnum block text-3xl leading-none font-semibold tracking-[-0.03em] text-brand-text">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-sm font-semibold tracking-[0.12em] text-ink uppercase">{step.title}</h3>
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <!-- El tablero del producto: la primera prueba de que hay software real,
         puesta donde la página habla de lo que funciona hoy. -->
    <div class="reveal mt-14" data-reveal-delay="120">
      <DashboardPreview
        lang={lang}
        title={p.dashboard.title}
        period={p.dashboard.period}
        metrics={p.dashboard.metrics}
        chartTitle={p.dashboard.chartTitle}
        seriesLabels={p.dashboard.chartSeries}
        chartAlt={p.dashboard.chartAlt}
        illustrativeLabel={c.labels.illustrative}
      />
    </div>

    <div class="reveal mt-10 border-b border-line" data-reveal-delay="100">
      <Disclosure summary={p.status.capabilitiesLabel} meta={p.status.capabilitiesMeta}>
        <ul class="grid gap-x-16 sm:grid-cols-2">
          {
            p.status.today.map((item) => (
              <li class="border-b border-line py-5">
                <p class="text-base font-semibold text-ink">{item.title}</p>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </Disclosure>
    </div>
  </Section>

  <!-- =========================================================== HOJA DE RUTA -->
  <!-- Separada de «qué funciona hoy» por una sección entera y con la etiqueta
       «En desarrollo» en cada entrada, no una sola vez arriba: quien llega
       directo a este bloque desde un ancla o un buscador tiene que leer la
       etiqueta junto al título, no tres párrafos más arriba. -->
  <Section tone="ground" size="compact">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <div>
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
          {c.labels.roadmap}
        </p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
          {c.labels.inDevelopment}
        </h2>
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{p.status.roadmapIntro}</p>
      </div>

      <ul class="divide-y divide-line border-t border-b border-line">
        {
          p.status.future.map((item) => (
            <li class="py-6">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
                <Tag>{c.labels.inDevelopment}</Tag>
              </div>
              <p class="mt-2.5 max-w-[68ch] text-[0.9375rem] leading-relaxed text-muted">
                {item.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- ============================================================= FRONTERAS -->
  <Section tone="ground" size="compact">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <h2 class="reveal text-2xl font-semibold tracking-[-0.02em] text-ink lg:text-3xl">
        {p.boundaries.title}
      </h2>
      <ul class="reveal divide-y divide-line border-t border-b border-line" data-reveal-delay="80">
        {
          p.boundaries.items.map((item) => (
            <li class="flex items-start gap-5 py-5">
              <span aria-hidden="true" class="mt-3 block h-[2px] w-4 shrink-0 bg-brand" />
              <p class="text-base leading-relaxed font-medium text-ink lg:text-lg">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Cierre propio y no el `Cta` compartido. Quien llega al final de esta
       página ya sabe qué hace la plataforma: lo siguiente es ver cuánto cuesta,
       o verla funcionar. El Diagnóstico es un servicio y no se ofrece aquí como
       sustituto de una demostración. -->
  <section class="on-ink bg-ink text-on-ink">
    <div class="container-page py-20 lg:py-28">
      <div class="reveal max-w-3xl">
        <h2 class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] sm:text-[2.75rem] lg:text-5xl">
          {p.closing.title}
        </h2>
        <p class="mt-6 text-lg text-on-ink-muted">{p.closing.body}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          {
            negocio.mostrar_precios ? (
              <>
                <Button href={path('pricing', lang)} variant="onInk" size="lg">
                  {p.closing.primary}
                </Button>
                <Button href={agenda(lang)} variant="onInkGhost" size="lg" data-cta="agenda">
                  {p.closing.schedule}
                </Button>
              </>
            ) : (
              <Button href={agenda(lang)} variant="onInk" size="lg" data-cta="agenda">
                {p.closing.schedule}
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>
