---
/**
 * Aviso de privacidad y términos de servicio. Una sola plantilla para los dos
 * documentos: cambian el texto y la clave de ruta, no la maquetación.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import { path, type Lang, type PageKey } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
  doc: 'privacy' | 'terms';
}

const { lang, doc } = Astro.props;
const legal = t(lang, 'legal');
const content = legal[doc];
const pageKey: PageKey = doc;

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
---

<Base
  lang={lang}
  pageKey={pageKey}
  title={content.meta.title}
  description={content.meta.description}
>
  <Section tone="ground" size="compact" class="border-b border-line">
    <div class="max-w-3xl">
      <h1 class="text-[2rem] leading-tight font-semibold tracking-[-0.025em] text-ink lg:text-5xl">
        {content.title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted">{content.intro}</p>
      <p class="mt-6 text-sm text-muted">{legal.updated}</p>
    </div>
  </Section>

  <Section tone="ground" size="compact">
    <div class="max-w-3xl">
      {
        content.sections.map((section, i) => (
          <section class="border-b border-line py-8 first:pt-0 last:border-b-0">
            <h2 class="flex items-baseline gap-4 text-xl font-semibold text-ink">
              <span class="tnum text-xs font-semibold text-brand-text">
                {String(i + 1).padStart(2, '0')}
              </span>
              {section.title}
            </h2>
            <div class="mt-4 space-y-4 pl-0 sm:pl-9">
              {section.body.map((paragraph) => (
                <p class="text-[0.9375rem] leading-relaxed text-muted">{paragraph}</p>
              ))}
            </div>
          </section>
        ))
      }

      <!-- Vía de contacto del aviso. Si hay correo configurado se publica; si
           no, se enlaza el formulario. Lo que NO puede pasar es que no haya
           ninguna de las dos: el apartado de derechos ARCO remite aquí, y un
           aviso de privacidad sin forma de ejercerlos está incompleto.

           Antes, sin correo, esto imprimía «Correo de contacto aún no
           configurado» — un mensaje para el programador puesto delante de un
           visitante. -->
      <div class="mt-10 border-l-2 border-ink bg-panel-alt px-6 py-5">
        {
          contactEmail ? (
            <a
              href={`mailto:${contactEmail}`}
              class="text-[0.9375rem] font-medium text-brand-text underline underline-offset-4"
            >
              {contactEmail}
            </a>
          ) : (
            <a
              href={path('contact', lang)}
              class="text-[0.9375rem] font-medium text-brand-text underline underline-offset-4"
            >
              {legal.contactFallback}
            </a>
          )
        }
      </div>
    </div>
  </Section>
</Base>
