---
/**
 * Servicios (consultoría México).
 *
 * Orden: el recorrido —para que se entienda cómo encajan los seis— y después
 * las tarjetas: los dos diagnósticos destacados arriba, porque son la puerta de
 * entrada, y los otros cuatro debajo. Cada tarjeta lleva `id` para enlazarla
 * (`/es/servicios/#diagnostico`).
 *
 * Ningún importe se escribe aquí: salen de `negocio.ts` por `servicios.ts`.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import Recorrido from '../Recorrido.astro';
import Cta from '../Cta.astro';
import Tag from '../Tag.astro';
import { serviciosResueltos, type ServicioResuelto } from '../../i18n/servicios';
import { agenda, contratarServicio } from '../../config/enlaces';
import { path } from '../../i18n/routes';
import { es } from '../../i18n';

const s = es('services');
const lang = 'es';
const servicios = serviciosResueltos();
const porId = (id: ServicioResuelto['id']) => servicios.find((x) => x.id === id)!;
const destacados = servicios.filter((x) => x.esPuertaDeEntrada);
const otros = servicios.filter((x) => !x.esPuertaDeEntrada);
const agendaHref = agenda(lang);

const nodo = (id: ServicioResuelto['id']) => ({ label: porId(id).nombre, href: `#${id}` });
---

<Base lang={lang} pageKey="services" title={s.meta.title} description={s.meta.description}>
  <PageHero eyebrow={s.hero.eyebrow} title={s.hero.title} intro={s.hero.subtitle}>
    <Fragment slot="actions">
      <Button href={agendaHref} size="lg">{s.labels.cta}</Button>
    </Fragment>
  </PageHero>

  <!-- ============================================================= RECORRIDO -->
  <Section tone="ground" size="compact">
    <div class="reveal">
      <SectionHeader eyebrow={s.journey.eyebrow} title={s.journey.title} intro={s.journey.intro} />
    </div>
    <Recorrido
      class="reveal mt-10"
      inicio={{ ...s.journey.start, href: agendaHref }}
      opciones={[nodo('diagnostico'), nodo('expansion'), nodo('mercado')]}
      ramaDesde={1}
      rama={{ ...nodo('franquicia'), condicion: s.journey.branch }}
      fin={{ ...s.journey.end, href: '#acompanamiento' }}
      alt={s.journey.alt}
    />
  </Section>

  <!-- ============================================================ DESTACADOS -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader title={s.featured.title} intro={s.featured.intro} />
    </div>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        destacados.map((sv, i) => (
          <article
            id={sv.id}
            class="reveal flex scroll-mt-28 flex-col rounded-card border-2 border-brand bg-panel p-7 lg:p-9"
            data-reveal-delay={i * 70}
          >
            <Tag tone="brand" class="self-start">{s.labels.entryPoint}</Tag>
            <h3 class="mt-5 text-2xl leading-snug font-medium tracking-[-0.01em] text-ink lg:text-[1.75rem]">
              {sv.nombre}
            </h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{sv.paraQuien}</p>

            <dl class="mt-6 flex-1 divide-y divide-line border-t border-line">
              <div class="py-3.5">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{s.labels.includes}</dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{sv.incluye}</dd>
              </div>
              <div class="py-3.5">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{s.labels.deliverable}</dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{sv.entregable}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-3.5">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{s.labels.duration}</dt>
                <dd class="text-[0.9375rem] font-medium text-ink">{sv.duracion}</dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 rounded-control bg-panel-alt px-5 py-4">
              <div>
                <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-brand-text uppercase">{s.labels.price}</p>
                <p class="tnum mt-1 text-2xl font-semibold text-ink">{sv.precio} <span class="text-sm font-medium text-muted">MXN</span></p>
              </div>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
                <Button href={agendaHref}>{s.labels.cta}</Button>
                <a
                  href={contratarServicio(sv.id, lang)}
                  class="text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
                >
                  {s.labels.write}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ================================================================ OTROS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader title={s.others.title} intro={s.others.intro} />
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        otros.map((sv, i) => (
          <article
            id={sv.id}
            class="reveal flex scroll-mt-28 flex-col rounded-card border border-line bg-panel p-7 lg:p-8"
            data-reveal-delay={(i % 2) * 70}
          >
            <h3 class="text-xl leading-snug font-medium tracking-[-0.01em] text-ink lg:text-2xl">{sv.nombre}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{sv.paraQuien}</p>

            <dl class="mt-6 flex-1 divide-y divide-line border-t border-line">
              <div class="py-3.5">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{s.labels.includes}</dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{sv.incluye}</dd>
              </div>
              <div class="py-3.5">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{s.labels.deliverable}</dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{sv.entregable}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-3.5">
                <dt class="text-[0.6875rem] font-semibold tracking-[0.12em] text-muted uppercase">{s.labels.duration}</dt>
                <dd class="text-[0.9375rem] font-medium text-ink">{sv.duracion}</dd>
              </div>
            </dl>

            <div class="mt-6 border-l-[3px] border-brand pl-4">
              <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-brand-text uppercase">{s.labels.price}</p>
              {
                sv.tramos.length > 0 ? (
                  <ul class="mt-2 space-y-1.5">
                    {sv.tramos.map((tr) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <span class="text-[0.9375rem] text-muted">{tr.etiqueta}</span>
                        <span class="tnum text-lg font-semibold text-ink">
                          {tr.importe}
                          {tr.importe !== s.labels.quote && (
                            <span class="ml-1 text-xs font-medium text-muted">{sv.unidad}</span>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="tnum mt-2 text-xl font-semibold text-ink">
                    {sv.precio}
                    {sv.unidad && <span class="ml-1.5 text-xs font-medium text-muted">{sv.unidad}</span>}
                  </p>
                )
              }
              {sv.nota && <p class="mt-3 text-sm leading-relaxed text-muted">{sv.nota}</p>}
            </div>

            <div class="mt-7">
              <Button href={contratarServicio(sv.id, lang)} variant="secondary">{s.labels.request}</Button>
            </div>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 max-w-3xl text-sm leading-relaxed text-muted">{s.tax}</p>
  </Section>

  <Cta
    title={s.closing.title}
    body={s.closing.body}
    primary={{ href: agendaHref, label: s.closing.primary }}
    secondary={{ href: path('expansion', lang), label: s.closing.secondary }}
  />
</Base>
