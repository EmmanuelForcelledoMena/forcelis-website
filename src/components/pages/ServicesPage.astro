---
/**
 * Servicios.
 *
 * El catálogo completo de la consultoría, del servicio más pequeño al más
 * grande — que es también el orden en que un cliente los va contratando.
 *
 * Dos decisiones de composición:
 *
 *  1. Las dos PUERTAS DE ENTRADA (Diagnóstico de Negocio y Estudio de
 *     Expansión) llevan un distintivo. Son seis tarjetas con la misma forma y
 *     sin esa marca un dueño no sabe por cuál empezar: las leería como un menú
 *     de opciones equivalentes, que no lo son.
 *  2. El recorrido va ARRIBA, antes del catálogo. Entender que todo empieza
 *     con una llamada y termina en el acompañamiento mensual es lo que da
 *     sentido a los seis; al revés, son seis precios sueltos.
 *
 * Ningún importe se escribe aquí: salen de `negocio.ts` por `servicios.ts`.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import DataFlow from '../DataFlow.astro';
import Tag from '../Tag.astro';
import { serviciosResueltos } from '../../i18n/servicios';
import { agenda, contratarServicio } from '../../config/enlaces';
import { path, type Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang, 'services');
const servicios = serviciosResueltos(lang);
const agendaHref = agenda(lang);
---

<Base lang={lang} pageKey="services" title={s.meta.title} description={s.meta.description}>
  <PageHero
    photoKey="services"
    eyebrow={s.hero.eyebrow}
    title={s.hero.title}
    intro={s.hero.subtitle}
  >
    <Fragment slot="actions">
      <Button href={agendaHref} variant="onInk" size="lg" data-cta="agenda">
        {s.labels.cta}
      </Button>
    </Fragment>
  </PageHero>

  <!-- ============================================================= RECORRIDO -->
  <Section tone="panel" size="compact">
    <div class="reveal">
      <SectionHeader title={s.journey.title} intro={s.journey.intro} />
    </div>
    <div class="reveal mt-10" data-reveal-delay="80">
      <DataFlow items={s.journey.flow} emphasis={3} alt={s.journey.flowAlt} />
    </div>
  </Section>

  <!-- ============================================================== CATÁLOGO -->
  <Section tone="ground">
    <div class="grid gap-px border border-line bg-line lg:grid-cols-2">
      {
        servicios.map((sv, i) => (
          <article
            class="reveal flex flex-col bg-panel p-7 lg:p-8"
            data-reveal-delay={(i % 2) * 70}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <h2 class="text-xl leading-snug font-semibold tracking-[-0.02em] text-ink lg:text-2xl">
                {sv.nombre}
              </h2>
              {sv.esPuertaDeEntrada && <Tag tone="brand">{s.labels.entryPoint}</Tag>}
            </div>

            <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{sv.paraQuien}</p>

            <dl class="mt-6 flex-1 divide-y divide-line border-t border-line">
              <div class="py-3.5">
                <dt class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {s.labels.includes}
                </dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{sv.incluye}</dd>
              </div>
              <div class="py-3.5">
                <dt class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {s.labels.deliverable}
                </dt>
                <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink">{sv.entregable}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-3.5">
                <dt class="text-[0.625rem] font-semibold tracking-[0.14em] text-muted uppercase">
                  {s.labels.duration}
                </dt>
                <dd class="text-[0.9375rem] font-medium text-ink">{sv.duracion}</dd>
              </div>
            </dl>

            <!-- El precio en su propio bloque, con filo de marca: es el dato
                 que la persona está buscando en toda la tarjeta. -->
            <div class="mt-6 border-l-2 border-brand pl-4">
              <p class="text-[0.625rem] font-semibold tracking-[0.14em] text-brand-text uppercase">
                {s.labels.price}
              </p>
              {
                sv.tramos.length > 0 ? (
                  <ul class="mt-2 space-y-1.5">
                    {sv.tramos.map((tr) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <span class="text-[0.9375rem] text-muted">{tr.etiqueta}</span>
                        <span class="tnum text-lg font-semibold text-ink">
                          {tr.importe}
                          <span class="ml-1 text-xs font-medium text-muted">{sv.unidad}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="tnum mt-2 text-xl font-semibold text-ink">
                    {sv.precio}
                    {sv.unidad && <span class="ml-1.5 text-xs font-medium text-muted">{sv.unidad}</span>}
                  </p>
                )
              }
              {sv.nota && <p class="mt-3 text-sm leading-relaxed text-muted">{sv.nota}</p>}
            </div>

            <div class="mt-7">
              <Button
                href={sv.esPuertaDeEntrada ? agendaHref : contratarServicio(sv.id, lang)}
                variant={sv.esPuertaDeEntrada ? 'primary' : 'secondary'}
                data-cta={sv.esPuertaDeEntrada ? 'agenda' : undefined}
              >
                {s.labels.cta}
              </Button>
            </div>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-8 max-w-3xl text-sm leading-relaxed text-muted">{s.tax}</p>
  </Section>

  <!-- ================================================================ CIERRE -->
  <section class="on-ink bg-ink text-on-ink">
    <div class="container-page py-20 lg:py-28">
      <div class="reveal max-w-3xl">
        <h2 class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] sm:text-[2.75rem] lg:text-5xl">
          {s.closing.title}
        </h2>
        <p class="mt-6 text-lg text-on-ink-muted">{s.closing.body}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href={agendaHref} variant="onInk" size="lg" data-cta="agenda">
            {s.closing.primary}
          </Button>
          <Button href={path('expansion', lang)} variant="onInkGhost" size="lg">
            {s.closing.secondary}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Base>
