---
/**
 * Portada.
 *
 * Giro del 2026-11-06: Forcelis deja de vender software a contadores y pasa a
 * ser consultoría de crecimiento y franquicias para pequeños negocios
 * mexicanos. La plataforma sigue existiendo, pero como herramienta interna —es
 * la razón de que el análisis salga de facturas y no de lo que cuenta el
 * dueño—, no como algo que se compre. Por eso la portada no la ofrece.
 *
 * Orden: la promesa (hero) → para quién es → el problema → los tres pasos del
 * trabajo → por qué nosotros → cierre.
 *
 * Una sola acción en toda la página: agendar la llamada de 20 minutos. Todo
 * botón primario lleva ahí.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import ProcessSteps from '../ProcessSteps.astro';
import InlineTermList from '../InlineTermList.astro';
import { agenda } from '../../config/enlaces';
import { path, type Lang } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang, 'home');
const agendaHref = agenda(lang);
---

<Base lang={lang} pageKey="home" title={h.meta.title} description={h.meta.description}>
  <!-- ================================================================== HERO -->
  <PageHero
    photoKey="home"
    size="tall"
    eyebrow={h.hero.eyebrow}
    title={h.hero.titleLead}
    titleAccent={h.hero.titleAccent}
    intro={h.hero.subtitle}
  >
    <Fragment slot="actions">
      <Button href={agendaHref} variant="onInk" size="lg" data-cta="agenda">
        {h.hero.primary}
      </Button>
      <Button href={path('expansion', lang)} variant="onInkGhost" size="lg">
        {h.hero.secondary}
      </Button>
    </Fragment>
  </PageHero>

  <!-- ============================================================ PARA QUIÉN -->
  <section class="border-b border-line bg-ground">
    <div class="container-page grid gap-6 py-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16 lg:py-12">
      <div class="reveal">
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
          {h.audience.label}
        </p>
        <InlineTermList items={h.audience.items} class="mt-4" />
      </div>
      <p
        class="reveal max-w-3xl self-center text-lg leading-relaxed text-muted"
        data-reveal-delay="80"
      >
        {h.audience.body}
      </p>
    </div>
  </section>

  <!-- ============================================================== PROBLEMA -->
  <Section tone="panel">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,16rem)_1fr] lg:gap-16">
      <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
        {h.problem.eyebrow}
      </p>
      <div>
        <h2 class="max-w-3xl text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-ink lg:text-[2.25rem]">
          {h.problem.title}
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{h.problem.body}</p>
      </div>
    </div>
  </Section>

  <!-- ================================================================== CÓMO -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={h.how.eyebrow} title={h.how.title} />
    </div>

    <ProcessSteps
      items={h.how.steps.map((paso) => ({ title: paso.name, body: paso.body }))}
      columns={3}
      class="mt-14"
    />

    <div class="reveal mt-12">
      <Button href={path('services', lang)} variant="secondary">{h.how.cta}</Button>
    </div>
  </Section>

  <!-- =============================================================== POR QUÉ -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader eyebrow={h.why.eyebrow} title={h.why.title} tone="light" />
    </div>

    <ol class="mt-14 grid gap-10 border-t border-line-ink pt-10 sm:grid-cols-3 sm:gap-8">
      {
        h.why.items.map((item, i) => (
          <li class="reveal" data-reveal-delay={i * 80}>
            <span class="tnum text-xs font-semibold text-on-ink-muted">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-xl leading-snug font-semibold text-on-ink">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-on-ink-muted">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ================================================================ CIERRE -->
  <Section tone="ground">
    <div class="reveal max-w-3xl">
      <h2 class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] text-ink sm:text-[2.75rem] lg:text-5xl">
        {h.closing.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">{h.closing.body}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href={agendaHref} size="lg" data-cta="agenda">{h.closing.primary}</Button>
        <Button href={path('services', lang)} variant="secondary" size="lg">
          {h.closing.secondary}
        </Button>
      </div>
    </div>
  </Section>
</Base>
