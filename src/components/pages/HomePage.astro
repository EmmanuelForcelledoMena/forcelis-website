---
/**
 * Portada en español: la línea de consultoría para pequeños negocios
 * mexicanos, que es la audiencia principal del sitio.
 *
 * Orden: la promesa → para quién es → el problema → dos formas de empezar →
 * cómo trabajamos → por qué Forcelis → franja para asesores → cierre.
 *
 * Estilo de dueño de negocio: blanco cálido, texto negro, rojo de acento. La
 * única franja oscura es la de asesores, que es OTRA audiencia y así se nota.
 *
 * Una acción principal en toda la página: agendar la llamada de 20 minutos.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import ProcessSteps from '../ProcessSteps.astro';
import MiniReporte from '../MiniReporte.astro';
import Cta from '../Cta.astro';
import Wordmark from '../Wordmark.astro';
import { negocio, precio, servicio } from '../../config/negocio';
import { agenda } from '../../config/enlaces';
import { path } from '../../i18n/routes';
import { common, es } from '../../i18n';

const lang = 'es';
const h = es('home');
const c = common(lang);
const planes = es('pricing').plans;
const agendaHref = agenda(lang);

const oferta = negocio.oferta_lanzamiento;
const textoOferta = h.advisors.offer
  .replace('{months}', String(oferta.meses_gratis))
  .replace('{plan}', planes[oferta.plan].name);

// «Desde» = el mínimo del rango publicado en negocio.ts.
const desde = (id: 'diagnostico' | 'expansion') => precio(servicio(id).desde!, lang);
const destino = (id: 'diagnostico' | 'expansion') =>
  id === 'expansion' ? path('expansion', lang) : `${path('services', lang)}#diagnostico`;
---

<Base lang={lang} pageKey="home" title={h.meta.title} description={h.meta.description}>
  <!-- ================================================================== HERO -->
  <PageHero
    size="tall"
    eyebrow={h.hero.eyebrow}
    title={h.hero.titleLead}
    titleAccent={h.hero.titleAccent}
    intro={h.hero.subtitle}
  >
    <Fragment slot="actions">
      <Button href={agendaHref} size="lg">{h.hero.primary}</Button>
      <Button href={path('services', lang)} variant="secondary" size="lg">{h.hero.secondary}</Button>
    </Fragment>

    <MiniReporte
      class="reveal hidden lg:block"
      titulo={h.preview.title}
      ilustrativo={c.labels.illustrative}
      grafica={h.preview.chart}
      graficaAlt={h.preview.chartAlt}
      margenTitulo={h.preview.marginTitle}
      filas={h.preview.rows}
      accion={h.preview.action}
    />
  </PageHero>

  <!-- ============================================================ PARA QUIÉN -->
  <section class="border-b border-line bg-panel">
    <div class="container-page grid gap-6 py-12 lg:grid-cols-[minmax(0,18rem)_1fr] lg:gap-16 lg:py-14">
      <div class="reveal">
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">{h.audience.label}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            h.audience.items.map((item) => (
              <li class="rounded-full border border-line bg-ground px-3.5 py-1.5 text-sm font-medium text-ink">{item}</li>
            ))
          }
        </ul>
      </div>
      <p class="reveal max-w-3xl self-center text-lg leading-relaxed text-muted" data-reveal-delay="80">
        {h.audience.body}
      </p>
    </div>
  </section>

  <!-- ============================================================== PROBLEMA -->
  <Section tone="ground">
    <div class="reveal grid gap-8 lg:grid-cols-[minmax(0,16rem)_1fr] lg:gap-16">
      <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">{h.problem.eyebrow}</p>
      <div>
        <h2 class="max-w-3xl text-[1.875rem] leading-tight font-medium tracking-[-0.01em] text-ink lg:text-[2.5rem]">
          {h.problem.title}
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{h.problem.body}</p>
      </div>
    </div>
  </Section>

  <!-- ============================================================== EMPEZAR -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={h.start.eyebrow} title={h.start.title} />
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        h.start.items.map((item, i) => {
          const id = item.id as 'diagnostico' | 'expansion';
          return (
            <a
              href={destino(id)}
              class="reveal group flex flex-col rounded-card border border-line bg-panel p-7 transition-[border-color,box-shadow] hover:border-brand hover:shadow-[0_18px_40px_-28px_rgba(169,41,40,0.55)] lg:p-9"
              data-reveal-delay={i * 80}
            >
              <span aria-hidden="true" class="block h-1 w-10 rounded-full bg-brand" />
              <h3 class="mt-6 text-2xl font-medium tracking-[-0.01em] text-ink lg:text-[1.75rem]">{item.name}</h3>
              <p class="mt-3 flex-1 text-lg leading-relaxed text-muted">{item.body}</p>
              <p class="mt-8 flex flex-wrap items-baseline gap-x-2">
                <span class="text-sm text-muted">{h.start.from}</span>
                <span class="tnum text-3xl font-semibold tracking-[-0.01em] text-ink">{desde(id)}</span>
                <span class="text-sm font-medium text-muted">{h.start.currency} {h.start.tax}</span>
              </p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-brand-text">
                {item.cta}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
                  <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>
  </Section>

  <!-- ================================================================== CÓMO -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={h.how.eyebrow} title={h.how.title} />
    </div>
    <ProcessSteps items={h.how.steps} columns={3} class="mt-14" />
    <div class="reveal mt-12">
      <Button href={path('services', lang)} variant="secondary">{h.how.cta}</Button>
    </div>
  </Section>

  <!-- =============================================================== POR QUÉ -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={h.why.eyebrow} title={h.why.title} />
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        h.why.items.map((item, i) => (
          <li class="reveal rounded-card border border-line bg-panel p-7" data-reveal-delay={i * 80}>
            <span class="tnum text-sm font-semibold text-brand-text">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-xl leading-snug font-medium text-ink">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ============================================================= ASESORES -->
  <section class="on-ink relative overflow-hidden bg-ink text-on-ink">
    <div aria-hidden="true" class="pointer-events-none absolute top-1/2 right-[-3rem] hidden -translate-y-1/2 md:block">
      <Wordmark symbolOnly height={240} />
    </div>
    <div class="container-page relative py-14 lg:py-16">
      <div class="reveal max-w-2xl">
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-on-ink-muted uppercase">{h.advisors.eyebrow}</p>
        <h2 class="mt-4 text-2xl leading-snug font-medium tracking-[-0.01em] text-on-ink lg:text-[2rem]">
          {h.advisors.title}
        </h2>
        <p class="mt-4 inline-flex rounded-control border border-on-ink-muted/60 px-3 py-1.5 text-base font-semibold text-on-ink">
          {textoOferta}
        </p>
        <div class="mt-8">
          <Button href={path('advisors', lang)} variant="onInk">{h.advisors.cta}</Button>
        </div>
      </div>
    </div>
  </section>

  <Cta title={h.closing.title} body={h.closing.body} primary={{ href: agendaHref, label: h.closing.primary }} />
</Base>
