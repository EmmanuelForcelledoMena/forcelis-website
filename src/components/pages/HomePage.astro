---
/**
 * Cuerpo de la portada, compartido por `/en/` y `/es/`.
 *
 * El inglés y el español NO son dos sitios: son dos versiones localizadas del
 * mismo (Sección 58 del brief). Por eso la maquetación vive una sola vez aquí y
 * lo único que cambia es el diccionario que recibe.
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import DashboardPreview from '../DashboardPreview.astro';
import ProblemFlow from '../ProblemFlow.astro';
import SolutionCard from '../SolutionCard.astro';
import ScorePanel from '../ScorePanel.astro';
import Cta from '../Cta.astro';
import Icon from '../Icon.astro';
import { path, type Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang, 'home');
const c = common(lang);

const iconFor: Record<string, 'financial' | 'operational' | 'supply' | 'accounting' | 'advisory' | 'managed'> = {
  financial: 'financial',
  operational: 'operational',
  supply: 'supply',
  accounting: 'accounting',
  advisory: 'advisory',
  managed: 'managed',
};
---

<Base lang={lang} pageKey="home" title={h.meta.title} description={h.meta.description}>
  <!-- ================================================================== HERO -->
  <section class="border-b border-line bg-ground pt-16 pb-20 lg:pt-24 lg:pb-28">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="reveal text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
          {h.hero.eyebrow}
        </p>
        <h1
          class="reveal mt-6 text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.035em] text-ink sm:text-6xl lg:text-display"
          data-reveal-delay="60"
        >
          {h.hero.title}
        </h1>
        <p class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-muted lg:text-xl" data-reveal-delay="120">
          {h.hero.subtitle}
        </p>
        <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row" data-reveal-delay="180">
          <Button href={path('diagnostic', lang)} size="lg">{c.cta.diagnostic}</Button>
          <Button href={path('solutions', lang)} variant="secondary" size="lg">
            {c.cta.explore}
          </Button>
        </div>
      </div>

      <div class="reveal mt-16 lg:mt-20" data-reveal-delay="240">
        <DashboardPreview
          lang={lang}
          title={h.hero.panelTitle}
          period={h.hero.panelPeriod}
          metrics={h.hero.metrics}
          chartTitle={h.hero.chartTitle}
          seriesLabels={h.hero.chartSeries}
          chartAlt={h.hero.chartAlt}
          illustrativeLabel={c.labels.illustrative}
        />
      </div>
    </div>
  </section>

  <!-- ============================================================= PROBLEMA -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={h.problem.eyebrow} title={h.problem.title} />
      <div class="mt-8 grid max-w-4xl gap-5">
        {h.problem.body.map((paragraph) => <p class="text-lg leading-relaxed text-muted">{paragraph}</p>)}
      </div>
    </div>

    <div class="reveal mt-14 lg:mt-16" data-reveal-delay="100">
      <ProblemFlow
        from={h.problem.flow.from}
        via={h.problem.flow.via}
        to={h.problem.flow.to}
        sources={h.problem.sources}
        outcomes={h.problem.outcomes}
      />
    </div>
  </Section>

  <!-- ============================================================== ENFOQUE -->
  <Section tone="ink">
    <div class="reveal">
      <SectionHeader
        eyebrow={h.approach.eyebrow}
        title={h.approach.title}
        intro={h.approach.intro}
        tone="light"
      />
    </div>

    <ol class="mt-16 grid gap-px border border-line-ink bg-line-ink lg:grid-cols-3">
      {
        h.approach.steps.map((step, i) => (
          <li class="reveal bg-ink p-8 lg:p-10" data-reveal-delay={i * 90}>
            <div class="flex items-baseline gap-4">
              <span class="tnum text-3xl font-semibold tracking-[-0.02em] text-brand">
                {step.num}
              </span>
              <span class="text-[0.6875rem] font-semibold tracking-[0.16em] text-on-ink-muted uppercase">
                {step.name}
              </span>
            </div>
            <h3 class="mt-6 text-xl leading-snug font-semibold text-on-ink">{step.title}</h3>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-on-ink-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============================================================ SOLUCIONES -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader
        eyebrow={h.solutions.eyebrow}
        title={h.solutions.title}
        intro={h.solutions.intro}
      />
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        h.solutions.cards.map((card, i) => (
          <div class="reveal" data-reveal-delay={(i % 3) * 80}>
            <SolutionCard
              icon={iconFor[card.key]}
              title={card.title}
              body={card.body}
              href={`${path('solutions', lang)}#${card.key}`}
              moreLabel={c.cta.learnMore}
            />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ============================================================ PLATAFORMA -->
  <Section tone="panel">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <SectionHeader eyebrow={h.platform.eyebrow} title={h.platform.title} />
        <div class="mt-8 space-y-5">
          {h.platform.body.map((paragraph) => <p class="text-lg leading-relaxed text-muted">{paragraph}</p>)}
        </div>
        <div class="mt-10">
          <Button href={path('platform', lang)} variant="secondary">{h.platform.cta}</Button>
        </div>
      </div>

      <ul class="reveal grid gap-px border border-line bg-line" data-reveal-delay="100">
        {
          h.platform.points.map((point) => (
            <li class="flex items-start gap-4 bg-panel p-6 lg:p-7">
              <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-brand-text" />
              <p class="text-[0.9375rem] leading-relaxed text-ink">{point}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- ============================================================ DIAGNÓSTICO -->
  <Section tone="ground">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,26rem)] lg:gap-16">
      <div class="reveal">
        <SectionHeader
          eyebrow={h.diagnostic.eyebrow}
          title={h.diagnostic.title}
          intro={h.diagnostic.subtitle}
        />

        <h3 class="mt-12 text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase">
          {h.diagnostic.findingsTitle}
        </h3>
        <ol class="mt-5 divide-y divide-line border-t border-b border-line">
          {
            h.diagnostic.findings.map((finding, i) => (
              <li class="flex items-baseline gap-5 py-4">
                <span class="tnum text-xs font-semibold text-brand-text">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="text-[0.9375rem] text-ink">{finding}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-10">
          <Button href={path('diagnostic', lang)}>{h.diagnostic.cta}</Button>
        </div>
      </div>

      <div class="reveal" data-reveal-delay="120">
        <ScorePanel
          title={h.diagnostic.scoreTitle}
          items={h.diagnostic.scores}
          illustrativeLabel={c.labels.illustrative}
          outOfLabel={c.labels.scoreOutOf}
        />
      </div>
    </div>
  </Section>

  <!-- ========================================================= MODELO SERVICIO -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={h.model.eyebrow} title={h.model.title} intro={h.model.intro} />
    </div>

    <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        h.model.stages.map((stage, i) => (
          <li class="reveal relative border-t-2 border-ink bg-panel p-6" data-reveal-delay={i * 80}>
            <span class="tnum text-xs font-semibold text-muted">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg font-semibold text-ink">{stage.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{stage.body}</p>
            {i < h.model.stages.length - 1 && (
              <span
                aria-hidden="true"
                class="absolute top-8 -right-3.5 hidden text-line-strong lg:block"
              >
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2 6h7M6.5 3 9.5 6l-3 3" stroke="currentColor" stroke-width="1.3" />
                </svg>
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============================================================= INDUSTRIAS -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader
        eyebrow={h.industries.eyebrow}
        title={h.industries.title}
        intro={h.industries.intro}
      />
    </div>

    <ul class="reveal mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        h.industries.items.map((item) => (
          <li class="bg-ground px-6 py-7 text-base font-medium text-ink">{item}</li>
        ))
      }
    </ul>

    <div class="reveal mt-10">
      <Button href={path('industries', lang)} variant="secondary">{h.industries.cta}</Button>
    </div>
  </Section>

  <!-- ============================================================ POR QUÉ -->
  <Section tone="panel">
    <div class="reveal">
      <SectionHeader eyebrow={h.why.eyebrow} title={h.why.title} />
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        h.why.pillars.map((pillar, i) => (
          <div class="reveal" data-reveal-delay={i * 70}>
            <span aria-hidden="true" class="block h-[2px] w-10 bg-brand" />
            <h3 class="mt-5 text-lg font-semibold text-ink">{pillar.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{pillar.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Cta
    lang={lang}
    title={h.closing.title}
    body={h.closing.body}
    primaryLabel={h.closing.primary}
    secondaryLabel={h.closing.secondary}
  />
</Base>
