---
/**
 * Portada, compartida por `/en/` y `/es/`.
 *
 * Rediseño v3. La página responde UNA pregunta —«¿qué es Forcelis?»— en cinco
 * bloques, y cada bloque responde una parte:
 *
 *   1. HERO — qué hace y cuál es el primer paso. El titular es la promesa
 *      («sabe dónde estás; sabe qué hacer»), el tablero de al lado es el
 *      producto (score global, cinco dimensiones, tres prioridades) y el
 *      botón es la única acción que el sitio pide.
 *   2. PARA QUIÉN — una franja de una línea: tamaño, complejidad, sectores.
 *      Sin esto el visitante no sabe si el sitio le habla a él.
 *   3. CÓMO — datos → inteligencia → acción, y los tres verbos (ver,
 *      entender, actuar). Absorbe las antiguas secciones «problema» y
 *      «enfoque», que decían lo mismo dos veces.
 *   4. QUÉ MEJORA — cuatro áreas de resultado y dos de apoyo. Sustituye a las
 *      seis tarjetas de servicio: seis fichas iguales se leían como catálogo.
 *   5. PUNTO DE PARTIDA — el diagnóstico como flujo de cinco pasos y un
 *      párrafo. Absorbe el antiguo panel de score (ya está en el hero), la
 *      lista de hallazgos (viven en la página del diagnóstico) y el «modelo
 *      de servicio» (una frase: lo que sigue se dimensiona desde el
 *      diagnóstico).
 *
 * Fuera: el tablero de ingresos/margen (ahora en Plataforma, que es donde
 * prueba que hay software), la sección «por qué Forcelis» (Nosotros) y la de
 * industrias (la franja 2 y la página de Industrias).
 */
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
import ScorePanel from '../ScorePanel.astro';
import DataFlow from '../DataFlow.astro';
import SolutionCard from '../SolutionCard.astro';
import InlineTermList from '../InlineTermList.astro';
import Cta from '../Cta.astro';
import { path, type Lang } from '../../i18n/routes';
import { t, common } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang, 'home');
const c = common(lang);

const iconFor: Record<string, 'financial' | 'operational' | 'supply' | 'accounting' | 'advisory' | 'managed'> = {
  financial: 'financial',
  operational: 'operational',
  supply: 'supply',
  accounting: 'accounting',
  advisory: 'advisory',
  managed: 'managed',
};
---

<Base lang={lang} pageKey="home" title={h.meta.title} description={h.meta.description}>
  <!-- ================================================================== HERO -->
  <PageHero
    photoKey="home"
    size="tall"
    eyebrow={h.hero.eyebrow}
    title={h.hero.titleLead}
    titleAccent={h.hero.titleAccent}
    intro={h.hero.subtitle}
  >
    <Fragment slot="actions">
      <Button href={path('diagnostic', lang)} variant="onInk" size="lg">{c.cta.diagnostic}</Button>
      <Button href="#how-it-works" variant="onInkGhost" size="lg">{c.cta.howItWorks}</Button>
    </Fragment>

    <!-- El tablero conserva su fondo de tarjeta sobre la banda de tinta a
         propósito: se lee como un objeto del producto, que es lo que es. -->
    <div class="reveal lg:self-center" data-reveal-delay="120">
      <ScorePanel
        title={h.hero.panelTitle}
        items={c.scores}
        illustrativeLabel={c.labels.illustrative}
        outOfLabel={c.labels.scoreOutOf}
        overallLabel={c.labels.overallScore}
        overallNote={c.labels.overallNote}
        priorities={{ label: h.hero.prioritiesLabel, items: h.hero.priorities }}
        density="compact"
      />
    </div>
  </PageHero>

  <!-- ============================================================ PARA QUIÉN -->
  <section class="border-b border-line bg-ground">
    <div class="container-page grid gap-6 py-10 lg:grid-cols-[minmax(0,18rem)_1fr] lg:gap-16 lg:py-12">
      <div class="reveal">
        <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
          {h.audience.label}
        </p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{h.audience.body}</p>
      </div>
      <div class="reveal flex flex-col justify-center gap-5" data-reveal-delay="80">
        <InlineTermList items={h.audience.items} />
        <a
          href={path('industries', lang)}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink"
        >
          {c.cta.seeIndustries}
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================== CÓMO -->
  <Section tone="panel" id="how-it-works">
    <div class="reveal">
      <SectionHeader eyebrow={h.how.eyebrow} title={h.how.title} intro={h.how.intro} />
    </div>

    <div class="reveal mt-14" data-reveal-delay="80">
      <DataFlow items={h.how.flow} emphasis={1} alt={h.how.flowAlt} />
    </div>

    <ol class="mt-14 grid gap-10 border-t-2 border-ink pt-8 sm:grid-cols-3 sm:gap-8">
      {
        h.how.steps.map((step, i) => (
          <li class="reveal" data-reveal-delay={i * 80}>
            <p class="flex items-baseline gap-3 text-[0.6875rem] font-semibold tracking-[0.16em] text-brand-text uppercase">
              <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
              {step.name}
            </p>
            <p class="mt-4 text-lg leading-snug font-semibold text-ink lg:text-xl">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-12 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{h.how.platformNote}</p>
      <Button href={path('platform', lang)} variant="secondary">{c.cta.seePlatform}</Button>
    </div>
  </Section>

  <!-- ============================================================ QUÉ MEJORA -->
  <Section tone="ground">
    <div class="reveal">
      <SectionHeader eyebrow={h.improve.eyebrow} title={h.improve.title} intro={h.improve.intro} />
    </div>

    <!-- Un solo marco para las dos filas; las hairlines son el hueco de un
         píxel sobre el color de línea, no un borde por tarjeta. -->
    <div class="mt-14 flex flex-col gap-px border border-line bg-line">
      <div class="grid gap-px sm:grid-cols-2 lg:grid-cols-4">
        {
          h.improve.areas.map((area, i) => (
            <div class="reveal flex" data-reveal-delay={(i % 4) * 70}>
              <SolutionCard
                icon={iconFor[area.key]}
                title={area.title}
                tags={area.tags}
                href={`${path('solutions', lang)}#${area.key}`}
                class="flex-1"
              >
                <Fragment slot="more">{c.cta.learnMore}</Fragment>
              </SolutionCard>
            </div>
          ))
        }
      </div>

      <div class="grid gap-px sm:grid-cols-2">
        {
          h.improve.support.map((item, i) => (
            <div class="reveal flex" data-reveal-delay={i * 70}>
              <SolutionCard
                variant="support"
                title={item.title}
                body={item.body}
                href={`${path('solutions', lang)}#${item.key}`}
                class="flex-1"
              >
                <Fragment slot="more">{c.cta.learnMore}</Fragment>
              </SolutionCard>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- ======================================================= PUNTO DE PARTIDA -->
  <Section tone="panel">
    <div class="grid gap-12 lg:grid-cols-[1fr_minmax(0,22rem)] lg:gap-24">
      <div class="reveal">
        <SectionHeader eyebrow={h.start.eyebrow} title={h.start.title} />
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{h.start.body}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href={path('diagnostic', lang)} size="lg">{c.cta.diagnostic}</Button>
          <Button href={`${path('diagnostic', lang)}#deliverables`} variant="secondary" size="lg">
            {h.start.secondary}
          </Button>
        </div>
      </div>

      <!-- Vertical a propósito, también en escritorio: al lado del texto se
           lee como la columna de un informe, que es lo que representa. -->
      <div class="reveal lg:self-center" data-reveal-delay="100">
        <DataFlow items={h.start.flow} emphasis={4} direction="column" alt={h.start.flowAlt} />
      </div>
    </div>
  </Section>

  <Cta
    lang={lang}
    title={h.closing.title}
    body={h.closing.body}
    primaryLabel={h.closing.primary}
    secondaryLabel={h.closing.secondary}
  />
</Base>
