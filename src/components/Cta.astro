---
/**
 * Cierre en tinta con dos botones.
 *
 * Los destinos se dan como clave de página (`primaryTo`), que es lo normal, o
 * como URL ya resuelta (`primaryHref`), que hace falta cuando el botón lleva
 * un `?tipo=` o sale a una agenda externa. La URL gana si están las dos.
 */
import Button from './Button.astro';
import { path, type Lang, type PageKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  body: string;
  primaryLabel: string;
  primaryTo?: PageKey;
  primaryHref?: string;
  secondaryLabel: string;
  secondaryTo?: PageKey;
  secondaryHref?: string;
}

const {
  lang,
  title,
  body,
  primaryLabel,
  primaryTo = 'diagnostic',
  primaryHref,
  secondaryLabel,
  secondaryTo = 'contact',
  secondaryHref,
} = Astro.props;

const primary = primaryHref ?? path(primaryTo, lang);
const secondary = secondaryHref ?? path(secondaryTo, lang);
---

<section class="on-ink bg-ink text-on-ink">
  <div class="container-page py-20 lg:py-28">
    <div class="reveal max-w-3xl">
      <h2
        class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] sm:text-[2.75rem] lg:text-5xl"
      >
        {title}
      </h2>
      <p class="mt-6 text-lg text-on-ink-muted">{body}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href={primary} variant="onInk" size="lg">{primaryLabel}</Button>
        <Button href={secondary} variant="onInkGhost" size="lg">{secondaryLabel}</Button>
      </div>
    </div>
  </div>
</section>
