---
/**
 * Forcelis Business Score.
 *
 * El color de cada barra sigue la banda del valor, pero el número siempre está
 * escrito al lado: el color es refuerzo, nunca el único portador del dato
 * —eso es WCAG 1.4.1 y es lo primero que se rompe en un tablero bonito—.
 *
 * La animación de conteo respeta `prefers-reduced-motion` y, si el script no
 * corre, el marcado ya trae el valor final escrito. Nada depende de JavaScript
 * para ser legible.
 */
interface ScoreItem {
  label: string;
  value: number;
  note?: string;
}

interface Props {
  title: string;
  items: readonly ScoreItem[];
  illustrativeLabel: string;
  outOfLabel: string;
  /** Etiqueta del medidor circular (i18n: `labels.overallScore`). */
  overallLabel: string;
  /** Texto pequeño bajo la etiqueta que dice de dónde sale la cifra. */
  overallNote: string;
  footnote?: string;
  class?: string;
}

const {
  title,
  items,
  illustrativeLabel,
  outOfLabel,
  overallLabel,
  overallNote,
  footnote,
  class: className = '',
} = Astro.props;

// La calificación global NO es un dato propio: es la media aritmética de las
// cinco dimensiones que se listan debajo, redondeada. El mockup del manual
// enseña un 72 que no sale de ningún sitio; aquí el número se deriva de lo que
// la propia tarjeta muestra, y por eso se puede publicar. Si mañana el producto
// define otra fórmula, cambia aquí y en ningún otro sitio.
const overall = Math.round(items.reduce((sum, item) => sum + item.value, 0) / items.length);

// Geometría del medidor: un arco de 270° abierto por abajo, que es lo que hace
// que se lea como indicador y no como donut de proporciones.
const R = 44;
const SWEEP = 270;
const arcLength = (2 * Math.PI * R * SWEEP) / 360;
const filled = (arcLength * overall) / 100;

function band(value: number): { fill: string; text: string } {
  // El relleno usa el color de dato; el número, su par legible. Son valores
  // distintos a propósito: el primero está calibrado para verse como barra y el
  // segundo para leerse como texto.
  if (value >= 80) return { fill: 'var(--color-data-green)', text: 'var(--color-data-green-text)' };
  if (value >= 60) return { fill: 'var(--color-data-blue)', text: 'var(--color-data-blue-text)' };
  return { fill: 'var(--color-data-amber)', text: 'var(--color-data-amber-text)' };
}
---

<figure class={`border border-line bg-panel ${className}`} data-score-panel>
  <figcaption class="flex items-center justify-between gap-4 border-b border-line px-6 py-5">
    <p class="text-sm font-semibold tracking-[0.02em] text-ink">{title}</p>
    <span
      class="shrink-0 border border-line-strong px-2 py-1 text-[0.625rem] font-medium tracking-[0.1em] text-muted uppercase"
    >
      {illustrativeLabel}
    </span>
  </figcaption>

  <div class="flex items-center gap-6 border-b border-line px-6 py-6">
    <svg
      viewBox="0 0 112 112"
      width="112"
      height="112"
      role="img"
      aria-label={`${overallLabel}: ${overall} ${outOfLabel}`}
      class="shrink-0"
    >
      <!-- El grupo se gira 135° para que el hueco del arco quede centrado
           abajo. Dos circunferencias con el mismo radio: la de fondo pinta el
           arco completo (270°) en color de línea; la de valor pinta la
           fracción en rojo de marca, con `stroke-dasharray` = longitud
           rellena + hueco mayor que la circunferencia. Es relleno, no texto,
           así que el rojo de marca aquí sí vale. -->
      <g transform="rotate(135 56 56)">
        <circle
          cx="56" cy="56" r={R} fill="none"
          stroke="var(--color-line)" stroke-width="7" stroke-linecap="round"
          stroke-dasharray={`${arcLength} ${2 * Math.PI * R}`}
        />
        <circle
          cx="56" cy="56" r={R} fill="none"
          stroke="var(--color-brand)" stroke-width="7" stroke-linecap="round"
          stroke-dasharray={`${filled} ${2 * Math.PI * R}`}
          data-score-arc={filled}
          class="transition-[stroke-dasharray] duration-1000 ease-out"
        />
      </g>
      <text
        x="56" y="58" text-anchor="middle" dominant-baseline="middle"
        class="tnum font-display"
        font-size="30" font-weight="700" fill="var(--color-ink)"
        data-score-value={overall}
      >{overall}</text>
      <text
        x="56" y="80" text-anchor="middle"
        font-size="10" font-weight="500" fill="var(--color-muted)" letter-spacing="0.06em"
      >/100</text>
    </svg>
    <div>
      <p class="text-sm font-semibold text-ink">{overallLabel}</p>
      <p class="mt-1 text-xs text-muted">{overallNote}</p>
    </div>
  </div>

  <ul class="divide-y divide-line">
    {
      items.map((item) => {
        const colors = band(item.value);
        return (
          <li class="px-6 py-5">
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-sm font-medium text-ink">{item.label}</p>
              <p class="tnum shrink-0 text-lg font-semibold" style={`color:${colors.text}`}>
                <span data-score-value={item.value}>{item.value}</span>
                <span class="sr-only"> {outOfLabel}</span>
              </p>
            </div>
            <div
              class="mt-3 h-1.5 w-full bg-panel-alt"
              role="img"
              aria-label={`${item.label}: ${item.value} ${outOfLabel}`}
            >
              <span
                class="block h-full origin-left transition-[width] duration-1000 ease-out"
                style={`width:${item.value}%;background:${colors.fill}`}
                data-score-bar={item.value}
              />
            </div>
            {item.note && <p class="mt-2.5 text-xs text-muted">{item.note}</p>}
          </li>
        );
      })
    }
  </ul>

  {
    footnote && (
      <p class="border-t border-line px-6 py-4 text-xs text-muted">{footnote}</p>
    )
  }
</figure>

<script>
  // Conteo y crecimiento de barra al entrar en pantalla. El marcado ya trae el
  // valor final; esto solo lo anima. Si algo aquí falla, el panel se ve
  // completo y correcto.
  const panels = document.querySelectorAll<HTMLElement>('[data-score-panel]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (panels.length && !reduced && 'IntersectionObserver' in window) {
    const animate = (panel: HTMLElement) => {
      const bars = panel.querySelectorAll<HTMLElement>('[data-score-bar]');
      const values = panel.querySelectorAll<HTMLElement>('[data-score-value]');

      bars.forEach((bar) => {
        const target = bar.style.width;
        bar.style.width = '0%';
        // Un fotograma de margen para que el navegador registre el 0% antes de
        // volver al valor final; sin él, la transición no se dispara.
        requestAnimationFrame(() => requestAnimationFrame(() => (bar.style.width = target)));
      });

      // El arco arranca en cero y crece hasta su longitud: la transición de
      // `stroke-dasharray` está declarada en el marcado.
      panel.querySelectorAll<SVGCircleElement>('[data-score-arc]').forEach((arc) => {
        const target = arc.getAttribute('stroke-dasharray') ?? '';
        const gap = target.split(' ')[1] ?? '0';
        arc.setAttribute('stroke-dasharray', `0 ${gap}`);
        requestAnimationFrame(() =>
          requestAnimationFrame(() => arc.setAttribute('stroke-dasharray', target)),
        );
      });

      values.forEach((node) => {
        const target = Number(node.dataset.scoreValue ?? 0);
        const start = performance.now();
        const duration = 900;
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          // easeOutCubic: llega rápido y se asienta, en lugar de frenar de golpe.
          const eased = 1 - Math.pow(1 - progress, 3);
          node.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(step);
        };
        node.textContent = '0';
        requestAnimationFrame(step);
      });
    };

    const inViewport = (el: HTMLElement) => {
      const rect = el.getBoundingClientRect();
      return rect.top < window.innerHeight && rect.bottom > 0;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    // Igual que en el revelado del layout: lo que ya se ve se anima sin esperar
    // al observador. Aquí no hace falta red de seguridad —el marcado ya trae el
    // valor y el ancho finales—, solo evitar que el panel del hero se quede
    // quieto en entornos donde el observador no dispara.
    panels.forEach((panel) => {
      if (inViewport(panel)) animate(panel);
      else observer.observe(panel);
    });
  }
</script>
