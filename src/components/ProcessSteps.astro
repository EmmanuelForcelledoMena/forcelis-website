---
/**
 * Pasos de un proceso: etapas numeradas colgadas de una sola regla superior.
 *
 * Cuatro etapas en cuatro tarjetas con borde superior se leen como cuatro
 * opciones. Colgadas de una regla continua se leen como una secuencia, que es
 * lo que son. Sustituye a `border-t-2 bg-panel p-6` repetido, y al mismo tiempo
 * elimina la flecha decorativa: la regla ya expresa la continuidad.
 */
interface Props {
  items: { title: string; body: string }[];
  tone?: 'ink' | 'light';
  /** Columnas en pantallas grandes; por defecto, una por paso (3 o 4). */
  columns?: 3 | 4;
  class?: string;
}

const { items, tone = 'ink', columns, class: className = '' }: Props = Astro.props;

// Tres pasos se ponen en tres columnas desde `md`: en dos columnas el tercero
// quedaba huérfano debajo, que se lee como un paso aparte. Cuatro, desde `lg`.
const tres = (columns ?? (items.length === 3 ? 3 : 4)) === 3;
const cols = tres ? 'md:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4';
const divisor = tres ? 'md:border-r' : 'lg:border-r';

const light = tone === 'light';
// Taupe sobre tinta, no rojo: ver la regla 2 de los tokens en global.css.
const numColor = light ? 'text-on-ink-muted' : 'text-brand-text';
const titleColor = light ? 'text-on-ink' : 'text-ink';
const bodyColor = light ? 'text-on-ink-muted' : 'text-muted';
const topRule = light ? 'border-line-ink' : 'border-ink';
const divider = light ? 'border-line-ink' : 'border-line';
---

<ol class:list={['grid border-t-2', cols, topRule, className]}>
  {
    items.map((item, i) => (
      <li
        class:list={[
          'reveal pt-6 pb-2 pr-6 md:pl-6 md:first:pl-0 lg:pr-8',
          i < items.length - 1 && [divisor, divider],
        ]}
        data-reveal-delay={i * 70}
      >
        <span class:list={['tnum block text-3xl leading-none font-semibold tracking-[-0.03em]', numColor]}>
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class:list={['mt-4 text-lg leading-snug font-medium', titleColor]}>{item.title}</h3>
        <p class:list={['mt-2.5 text-[0.9375rem] leading-relaxed', bodyColor]}>{item.body}</p>
      </li>
    ))
  }
</ol>
