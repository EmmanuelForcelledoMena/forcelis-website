---
/**
 * Tarjeta de plan.
 *
 * Todo lo que la tarjeta afirma sale de `negocio.ts`: el precio, las empresas
 * incluidas, si admite adicionales, si lleva marca propia y el uso justo. El
 * diccionario solo pone las palabras. Así una tarjeta no puede prometer un
 * límite o una prestación que la configuración no tiene: si mañana cambia una
 * cifra, cambia aquí sin tocar el copy.
 *
 * Lo que distingue a un plan de otro, hoy, es la capacidad —cuántas empresas— y
 * si los entregables salen con la marca del asesor. La tarjeta enseña eso y no
 * una lista de funciones por plan, porque la configuración no la define.
 *
 * Con los precios apagados la tarjeta sigue sirviendo: dice para quién es y qué
 * incluye, y el botón pide el precio.
 */
import Button from './Button.astro';
import { negocio, precio as formatoPrecio, type Plan } from '../config/negocio';
import type { Lang } from '../i18n/routes';

export interface EtiquetasPlan {
  companies: string;
  unlimited: string;
  quote: string;
  perMonth: string;
  tax: string;
  ownBrand: string;
  noBrand: string;
  /** Plantilla con `{price}`. */
  extra: string;
  /** Lo mismo, sin importe, para cuando los precios están apagados. */
  extraNoPrice: string;
  noExtra: string;
  /** Plantilla con `{n}`. */
  fairUse: string;
  customTerms: string;
  recommended: string;
}

interface Props {
  plan: Plan;
  /** Nombre del plan en el idioma de la página. */
  nombre: string;
  /** Para quién es, una línea. */
  paraQuien: string;
  /** Qué resuelve, una frase. Opcional. */
  resumen?: string;
  /** Texto del botón. */
  cta: string;
  href: string;
  labels: EtiquetasPlan;
  lang: Lang;
  /** Resalta la tarjeta. Para el plan que se recomienda por omisión. */
  destacado?: boolean;
  class?: string;
}

const {
  plan,
  nombre,
  paraQuien,
  resumen,
  cta,
  href,
  labels,
  lang,
  destacado = false,
  class: className = '',
} = Astro.props;

const mostrar = negocio.mostrar_precios;
const numero = new Intl.NumberFormat(lang === 'es' ? 'es-MX' : 'en-US');
const empresas = plan.empresas === null ? labels.unlimited : numero.format(plan.empresas);
const cotizado = plan.precio === null;

// Lo que incluye, en el orden en que se decide: marca, crecimiento, límite.
const incluye: string[] = [plan.marca_propia ? labels.ownBrand : labels.noBrand];
if (cotizado) {
  incluye.push(labels.customTerms);
} else {
  incluye.push(
    plan.admite_adicionales
      ? mostrar
        ? labels.extra.replace('{price}', formatoPrecio(negocio.empresa_adicional, lang))
        : labels.extraNoPrice
      : labels.noExtra,
  );
  incluye.push(labels.fairUse.replace('{n}', numero.format(negocio.uso_justo_cfdi_por_empresa_mes)));
}
---

<article
  class:list={[
    'relative flex flex-col bg-panel p-7',
    destacado && 'ring-2 ring-brand ring-inset',
    className,
  ]}
>
  <!-- La etiqueta va en la misma línea que el nombre: encima, empujaba el
       precio de esta tarjeta más abajo que el de sus vecinas. -->
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-sm font-semibold tracking-[0.14em] text-ink uppercase">{nombre}</h3>
    {
      destacado && (
        <p class="bg-brand px-2 py-0.5 text-[0.625rem] font-semibold tracking-[0.14em] whitespace-nowrap text-white uppercase">
          {labels.recommended}
        </p>
      )
    }
  </div>
  <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{paraQuien}</p>

  {
    mostrar && (
      <div class="mt-6">
        {cotizado ? (
          <p class="text-2xl font-semibold tracking-[-0.02em] text-ink">{labels.quote}</p>
        ) : (
          <>
            <p class="tnum flex flex-wrap items-baseline gap-x-1.5">
              <span class="font-display text-[2.25rem] leading-none font-bold tracking-[-0.03em] text-ink">
                {formatoPrecio(plan.precio as number, lang)}
              </span>
              <span class="text-sm text-muted">
                {negocio.moneda} {labels.perMonth}
              </span>
            </p>
            <p class="mt-1.5 text-xs text-muted">{labels.tax}</p>
          </>
        )}
      </div>
    )
  }

  {resumen && <p class="mt-5 text-[0.9375rem] leading-relaxed text-ink">{resumen}</p>}

  <!-- La lista de definiciones solo lleva pares `<dt>`/`<dd>`: cualquier otro
       hijo la invalida para los lectores de pantalla. Lo demás va en su
       propia lista. -->
  <div class="mt-6 flex-1 border-t border-line">
    <dl>
      <div class="flex items-baseline justify-between gap-4 border-b border-line py-3">
        <dt class="text-[0.8125rem] text-muted">{labels.companies}</dt>
        <dd class="tnum text-base font-semibold text-ink">{empresas}</dd>
      </div>
    </dl>
    <ul class="mt-4 space-y-2.5 text-[0.875rem] leading-snug text-ink">
      {
        incluye.map((linea) => (
          <li class="flex gap-2.5">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="mt-[0.2rem] shrink-0 text-brand-text">
              <path d="M2.5 7.5 5.5 10.5 11.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
            </svg>
            {linea}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-7">
    <Button href={href} variant={destacado ? 'primary' : 'secondary'}>{cta}</Button>
  </div>
</article>
