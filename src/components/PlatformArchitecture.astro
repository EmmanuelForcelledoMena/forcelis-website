---
/**
 * Arquitectura de la plataforma, de arriba abajo:
 *
 *     TUS SISTEMAS  (ocho fuentes)
 *          ↓
 *     FORCELIS      (conectar · normalizar · analizar · explicar)
 *          ↓
 *     DECISIONES
 *
 * Tres niveles, no cuatro: la versión anterior intercalaba una capa de
 * «inteligencia» (financiera, operativa, contable) que repetía el índice de
 * Soluciones y hacía que el diagrama pareciera un organigrama. Lo que la
 * plataforma HACE son cuatro verbos, y van dentro de su caja.
 *
 * Mismo criterio que `DataFlow`: cajas y texto, no una imagen. El resumen en
 * texto es para lectores de pantalla, porque la relación entre niveles la
 * comunica la disposición y eso no viaja por el árbol de accesibilidad.
 */
interface Props {
  sourcesLabel: string;
  sources: readonly string[];
  platformLabel: string;
  steps: readonly string[];
  outcomeLabel: string;
  outcomeSub: string;
  diagramAlt: string;
  class?: string;
}

const { sourcesLabel, sources, platformLabel, steps, outcomeLabel, outcomeSub, diagramAlt, class: className = '' } =
  Astro.props;
---

<div class:list={['mx-auto max-w-4xl', className]}>
  <p class="sr-only">{diagramAlt}</p>

  <div aria-hidden="true">
    <div class="border border-line bg-panel p-6 lg:p-7">
      <p class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted uppercase">
        {sourcesLabel}
      </p>
      <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
        {
          sources.map((source) => (
            <li class="border border-line bg-ground px-3 py-2.5 text-center text-[0.8125rem] font-medium tracking-[0.04em] text-muted uppercase">
              {source}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex justify-center py-3">
      <svg width="14" height="22" viewBox="0 0 14 22" fill="none" class="text-line-strong">
        <path d="M7 0v18M2.5 14 7 18.5 11.5 14" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </div>

    <div class="border border-ink bg-ink p-6 lg:p-7">
      <p class="text-center text-lg font-semibold tracking-[0.06em] text-on-ink uppercase">
        {platformLabel}
      </p>
      <ol class="mt-5 grid grid-cols-2 gap-px bg-line-ink sm:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="flex items-center justify-center gap-2 bg-ink px-3 py-3.5 text-center">
              <span class="tnum text-[0.625rem] font-semibold text-on-ink-muted">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-xs font-semibold tracking-[0.12em] text-on-ink uppercase">{step}</span>
            </li>
          ))
        }
      </ol>
      <span aria-hidden="true" class="mx-auto mt-5 block h-[2px] w-16 bg-taupe"></span>
    </div>

    <div class="flex justify-center py-3">
      <svg width="14" height="22" viewBox="0 0 14 22" fill="none" class="text-line-strong">
        <path d="M7 0v18M2.5 14 7 18.5 11.5 14" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </div>

    <div class="border-2 border-brand bg-ground px-6 py-6 text-center">
      <p class="text-base font-semibold tracking-[0.06em] text-ink uppercase">{outcomeLabel}</p>
      <p class="mt-1.5 text-sm text-muted">{outcomeSub}</p>
    </div>
  </div>
</div>
