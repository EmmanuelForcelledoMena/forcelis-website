---
import Icon from './Icon.astro';

interface Props {
  icon: 'financial' | 'operational' | 'supply' | 'accounting' | 'advisory' | 'managed';
  title: string;
  body: string;
  href: string;
  moreLabel: string;
}

const { icon, title, body, href, moreLabel } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col border border-line bg-panel p-7 transition-colors duration-200 hover:border-line-strong lg:p-8"
>
  <!-- El filo superior es el único sitio donde aparece el color de marca en la
       tarjeta: relleno, nunca fondo con texto encima. -->
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-[2px] origin-left scale-x-0 bg-brand transition-transform duration-300 group-hover:scale-x-100"
  ></span>

  <Icon name={icon} class="h-6 w-6 text-brand-text" />
  <h3 class="mt-6 text-lg font-semibold text-ink">{title}</h3>
  <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">{body}</p>
  <span
    class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink"
  >
    {moreLabel}
    <svg
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      aria-hidden="true"
      class="transition-transform duration-200 group-hover:translate-x-1"
    >
      <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.4"></path>
    </svg>
  </span>
</a>
