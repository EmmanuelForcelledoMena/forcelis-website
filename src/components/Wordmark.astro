---
/**
 * Logotipo horizontal de Forcelis: símbolo + FORCELIS.
 *
 * NO se redibuja aquí: se leen los trazos de `public/brand/logo-horizontal.svg`,
 * que genera `scripts/build-brand.mjs` a partir de los vectores del PDF de
 * marca. Si cambia la marca, se vuelve a correr ese script y este componente
 * sale bien solo.
 *
 * Color por superficie:
 *   `ink`   fondos claros: símbolo en sus tres rojos, texto negro.
 *   `light` fondos oscuros: símbolo en sus rojos, texto blanco — como el botón
 *           negro de la hoja de marca. El rojo sobre negro está permitido en
 *           el símbolo (es forma, no texto).
 *   `mono`  todo en blanco, para fondos rojos o fotografía.
 */
import logoSvg from '../../public/brand/logo-horizontal.svg?raw';

interface Props {
  tone?: 'ink' | 'light' | 'mono';
  /** Alto en píxeles del logotipo completo (el símbolo ocupa ese alto). */
  height?: number;
  /** Solo el símbolo, sin la palabra. */
  symbolOnly?: boolean;
  /**
   * `true` cuando el logotipo va dentro de un enlace que ya lleva su propia
   * etiqueta (la barra, el pie): así no se anuncia dos veces.
   */
  decorative?: boolean;
  class?: string;
}

const {
  tone = 'ink',
  height = 38,
  symbolOnly = false,
  decorative = true,
  class: className = '',
} = Astro.props;

const viewBox = /viewBox="([^"]+)"/.exec(logoSvg)![1];
const [, , vbW, vbH] = viewBox.split(' ').map(Number);
const paths = [...logoSvg.matchAll(/<path fill="([^"]+)" d="([^"]+)"\/>/g)].map((m) => ({
  fill: m[1],
  d: m[2],
}));
// Las tres primeras son las barras del símbolo; la cuarta, la palabra.
const barras = paths.slice(0, 3);
const palabra = paths[3];

const SIMBOLO_W = 71.28;
const ancho = symbolOnly ? SIMBOLO_W : vbW;
const width = Math.round((height * ancho) / vbH);

const colorBarra = (fill: string) => (tone === 'mono' ? 'var(--fc-blanco)' : fill);
const colorPalabra = tone === 'ink' ? 'var(--fc-negro)' : 'var(--fc-blanco)';
---

<svg
  viewBox={`0 0 ${ancho} ${vbH}`}
  width={width}
  height={height}
  class={`block shrink-0 ${className}`}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Forcelis'}
  focusable="false"
>
  {barras.map((b) => <path fill={colorBarra(b.fill)} d={b.d} />)}
  {!symbolOnly && palabra && <path fill={colorPalabra} d={palabra.d} />}
</svg>
