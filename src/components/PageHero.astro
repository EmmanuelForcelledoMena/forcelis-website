---
/**
 * Cabecera oscura de página, con fotografía de fondo.
 *
 * Es el patrón que atraviesa todos los mockups del manual: una banda de tinta
 * con una foto velada, el antetítulo en taupe, el titular en claro y, cuando
 * toca, el remate del titular en rojo. Es lo que separa visualmente el sitio de
 * un documento: cada página abre con una imagen y cierra en claro.
 *
 * La foto se resuelve en la build desde `src/assets/heroes/<photoKey>.*`. Si
 * el archivo no existe, la banda sigue siendo una banda: fondo de tinta con el
 * glifo de la marca como marca de agua. Nunca un hueco, nunca una imagen de
 * banco puesta por defecto — las fotos se eligen y se licencian aparte.
 *
 * Contraste sobre la foto: el velo va de tinta casi opaca en la columna del
 * texto a tinta al 40 % en el otro extremo, y el texto se limita a esa columna.
 * Así el titular se lee sobre CUALQUIER fotografía, clara u oscura, sin
 * depender de cómo salga la imagen que se ponga.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';

interface Props {
  /** Nombre del archivo de foto en `src/assets/heroes/`, sin extensión. */
  photoKey: string;
  eyebrow?: string;
  title: string;
  /**
   * Segunda frase del titular, en rojo y en su propia línea (solo texto
   * grande, ver `--color-brand-on-ink`). Va en bloque para que el cambio de
   * color coincida con el cambio de frase y no caiga a mitad de renglón.
   */
  titleAccent?: string;
  intro?: string;
  cta?: { href: string; label: string };
  /** Alto de la banda. `tall` para la portada. */
  size?: 'default' | 'tall';
}

const { photoKey, eyebrow, title, titleAccent, intro, cta, size = 'default' } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/heroes/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.entries(photos).find(([file]) =>
  new RegExp(`/${photoKey}\\.(jpe?g|png|webp)$`).test(file),
)?.[1].default;

const hasAside = Astro.slots.has('default');
const hasActions = Astro.slots.has('actions');
// El alto del hero en movil esta medido, no elegido: la pagina de asesores es
// la de aterrizaje de los anuncios y su boton tiene que verse sin scroll en un
// telefono de 375x667, que es el mas pequeno que sigue siendo comun. Con el
// relleno de escritorio, el boton caia 12 px por debajo del pliegue.
const padding = size === 'tall' ? 'py-12 sm:py-20 lg:py-28' : 'py-10 sm:py-16 lg:py-24';
---

<section class="on-ink relative overflow-hidden bg-ink text-on-ink">
  {
    photo ? (
      <Image
        src={photo}
        alt=""
        width={1920}
        height={1080}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <!-- Sin fotografía, la banda no se queda lisa: lleva el motivo de barras
           inclinadas de la marca, que es el mismo gesto del glifo de la F.
           Viene del tablero de referencia, donde esas barras cruzan el hero en
           rojo sobre la imagen.

           Dos capas: las rojas, que son el acento, y unas de taupe detrás que
           les dan profundidad. Van a opacidad baja y con el degradado encima,
           así que nunca compiten con el titular — el rojo aquí es relleno, no
           texto, y por eso puede ser el rojo de marca y no el levantado. -->
      <svg
        viewBox="0 0 120 64"
        preserveAspectRatio="xMaxYMid slice"
        aria-hidden="true"
        class="absolute inset-y-0 right-0 h-full w-[70%]"
      >
        <g fill="#c7c3a9" opacity="0.10">
          <path d="M34 -4H78L62 68H18Z" />
          <path d="M96 -4H124L108 68H80Z" />
        </g>
        <g fill="#c02626" opacity="0.5">
          <path d="M52 -4H74L58 68H36Z" />
          <path d="M84 18H102L92 68H74Z" />
          <path d="M108 -4H120L104 40H92Z" />
        </g>
      </svg>
    )
  }
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/40"
  ></div>
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-px bg-line-ink"></div>

  <div class={`container-page relative ${padding}`}>
    <div
      class:list={[
        'grid gap-12 lg:gap-16',
        hasAside ? 'items-stretch lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]' : '',
      ]}
    >
      <div class="flex max-w-3xl flex-col justify-center">
        {
          eyebrow && (
            <p class="reveal flex items-center gap-3 text-[0.6875rem] font-semibold tracking-[0.16em] text-on-ink-muted uppercase">
              <span aria-hidden="true" class="block h-[2px] w-8 bg-taupe" />
              {eyebrow}
            </p>
          )
        }
        <h1
          class="reveal mt-5 text-[2.125rem] leading-[1.05] font-bold tracking-[-0.025em] text-on-ink sm:mt-6 sm:text-5xl lg:text-display"
          data-reveal-delay="60"
        >
          {title}
          {titleAccent && <span class="block text-brand-on-ink">{titleAccent}</span>}
        </h1>
        {
          intro && (
            <p
              class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-on-ink-muted sm:mt-7 lg:text-xl"
              data-reveal-delay="120"
            >
              {intro}
            </p>
          )
        }
        {
          (cta || hasActions) && (
            <div class="reveal mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row" data-reveal-delay="180">
              {hasActions ? (
                <slot name="actions" />
              ) : (
                <Button href={cta!.href} variant="onInk" size="lg">
                  {cta!.label}
                </Button>
              )}
            </div>
          )
        }
      </div>

      {hasAside && <slot />}
    </div>
  </div>
</section>
