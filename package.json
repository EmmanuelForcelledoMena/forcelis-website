{
  "name": "forcelis-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Forcelis Group — bilingual corporate website (EN/ES)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:og": "node scripts/build-og.mjs",
    "build:linkedin": "node scripts/build-linkedin.mjs",
    "audit": "node scripts/audit.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:calc": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/calculator.test.mjs",
    "verify": "npm run check && npm run i18n:check && npm run test:calc && npm run build && npm run audit && npm run check:precios",
    "check:precios": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-precios.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.1.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2"
  }
}
